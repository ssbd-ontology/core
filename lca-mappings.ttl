# Example with EF v3.1 taken from INSIGHT
# TODO: Find semantic connection between ssbd:HumanToxicityNonCancerImpactAssessment and these Individuals

:environmental-footprint-31-name a oriont:MethodologyName ;
    rdfs:label "Environmental Footprint"@en .

:environmental-footprint-31 a oriont:Methodology ;
    rdfs:label "Environmental Footprint"@en ;
    oriont:hasMethodologyName :environmental-footprint-31-name ;
    oriont:containsMethod :method_7cfdcfcf-b222-4b26-888a-a55f9fbf7ac8 .

:method_7cfdcfcf-b222-4b26-888a-a55f9fbf7ac8-name a oriont:MethodName ;
    rdfs:label "EF 3.1; Human toxicity, non-cancer; midpoint; Comparative Toxic Unit for human (CTUh); USEtox 2.1"@en .

:method_7cfdcfcf-b222-4b26-888a-a55f9fbf7ac8 a oriont:Method ;
    rdfs:label "EF 3.1 non-cancer human health effects"@en ;
    oriont:hasMethodName :method_7cfdcfcf-b222-4b26-888a-a55f9fbf7ac8-name ;
    oriont:usesModel :usetox-2-1 .

:non-cancer-human-health-effects-name a oriont:ImpactCategoryName ;
    rdfs:label "Non-cancer human health effects"@en .

:non-cancer-human-health-effects a oriont:ImpactCategory ;
    rdfs:label "Non-cancer human health effects"@en ;
    oriont:hasImpactCategoryName :non-cancer-human-health-effects-name ;
    oriont:isAssessedByIndicator :indicator_comparative-toxic-unit-for-human-ctuh .

:ctuh a oriont:CFUnit ,
        oriont:IndicatorUnit ;
    rdfs:label "CTUh" .

:indicator_comparative-toxic-unit-for-human-ctuh-name a oriont:IndicatorName ;
    rdfs:label "Comparative Toxic Unit for human (CTUh)"@en .

:indicator_comparative-toxic-unit-for-human-ctuh a oriont:ImpactCategoryIndicator ;
    rdfs:label "Comparative Toxic Unit for human (CTUh)"@en ;
    oriont:hasIndicatorName :indicator_comparative-toxic-unit-for-human-ctuh-name ;
    oriont:hasIndicatorUnit :ctuh .

:usetox-2-1 a oriont:CharacterisationModel ;
    rdfs:label "USEtox 2.1™" ;
    rdfs:comment "USEtox is the UNEP/SETAC scientific consensus model for characterizing human toxicological and ecotoxicological impacts of chemical emissions in life cycle assessment. It is based on existing LCIA toxicity characterization models. It includes all vital model elements of toxicological effects assessment."@en .
