        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Resource"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <vann:usageNote xml:lang="en">Use `ddoc:curationDate` to refer to the date of curation.</vann:usageNote>
        <skos:definition xml:lang="en">The agent that curated the resource.</skos:definition>
