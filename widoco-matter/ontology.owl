        <skos:prefLabel xml:lang="en">datumDescription</skos:prefLabel>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/emmo/domain/datamodel#datumName -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/emmo/domain/datamodel#datumName">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">Name of the datum/property.</skos:definition>
        <skos:prefLabel xml:lang="en">datumName</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Typically the variable name used in a program or web interface. A string without spaces.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/emmo/domain/datamodel#datumShape -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/emmo/domain/datamodel#datumShape">
        <rdfs:range rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#JSON"/>
        <skos:definition xml:lang="en">Unit of the datum/property.</skos:definition>
        <skos:prefLabel xml:lang="en">datumShape</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Leave empty if scalar.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">List of the dimension names if the datum/property is multi-dimensional. Leave empty if it is a scalar.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/emmo/domain/datamodel#datumType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/emmo/domain/datamodel#datumType">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">Type of the datum/property.</skos:definition>
        <skos:prefLabel xml:lang="en">datumType</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Use one of bool, int, float, string. For int and float the number of bits can be added. E.g. int32, float64.</skos:scopeNote>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/emmo/domain/datamodel#datumUnit -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/emmo/domain/datamodel#datumUnit">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <skos:definition xml:lang="en">Unit of the datum/property.</skos:definition>
        <skos:prefLabel xml:lang="en">datumUnit</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Leave empty if dimensionless.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Use standard SI symbols.</skos:scopeNote>
    </owl:DatatypeProperty>
    


