    <rdf:Description rdf:about="https://w3id.org/ssbd/wasGeneratedBy">
        <rdfs:label xml:lang="en">was generated by</rdfs:label>
        <skos:definition xml:lang="en">Relates an entity to the activity it was generated from.</skos:definition>
        <skos:prefLabel xml:lang="en">wasGeneratedBy</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The activity A proper overlaps the entity E, where the non-overlapping part of E is caused by A.</skos:scopeNote>
    </rdf:Description>
    


