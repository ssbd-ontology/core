    </rdf:Description>
    


    <!-- http://www.blueobelisk.org/ontologies/chemoinformatics-algorithms/#AtomicDescriptor -->


    <rdf:Description rdf:about="http://www.blueobelisk.org/ontologies/chemoinformatics-algorithms/#AtomicDescriptor">
        <rdfs:subClassOf rdf:resource="http://semanticscience.org/resource/CHEMINF_000025"/>
    </rdf:Description>
    


    <!-- http://www.w3.org/ns/dcat#Resource -->


    <rdf:Description rdf:about="http://www.w3.org/ns/dcat#Resource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Data"/>
    </rdf:Description>
    


    <!-- http://xmlns.com/foaf/0.1/Document -->


    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Document">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Data"/>
    </rdf:Description>
    


    <!-- http://xmlns.com/foaf/0.1/Organization -->


    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Organization">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Object"/>
    </rdf:Description>
    


    <!-- http://xmlns.com/foaf/0.1/Person -->


    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Object"/>
    </rdf:Description>
    


    <!-- http://xmlns.com/foaf/0.1/Project -->


    <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Project">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Object"/>
    </rdf:Description>
    


    <!-- https://w3id.org/emmo/domain/datamodel#DataModel -->


    <rdf:Description rdf:about="https://w3id.org/emmo/domain/datamodel#DataModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Data"/>
    </rdf:Description>
    


    <!-- https://w3id.org/emmo/domain/microstructure#MeltingPointTemperature -->


    <rdf:Description rdf:about="https://w3id.org/emmo/domain/microstructure#MeltingPointTemperature">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#PhysicalQuantity"/>
    </rdf:Description>
    


    <!-- https://w3id.org/emmo/hume#AmorphousMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#AmorphousMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByStructure"/>
        <skos:altLabel xml:lang="en">NonCrystallineMaterial</skos:altLabel>
        <skos:definition xml:lang="en">A solid lacking a repeating, ordered atomic structure (long-range order).</skos:definition>
        <skos:prefLabel xml:lang="en">AmorphousMaterial</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A amorphous material resembles a frozen liquid with atoms arranged randomly, unlike crystalline solids with periodic patterns, leading to properties like no sharp melting point, irregular shapes, and isotropic characteristics (uniform properties in all directions).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#AnalogicalIcon -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#AnalogicalIcon">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Model"/>
        <skos:altLabel xml:lang="en">AnalogicalIcon</skos:altLabel>
        <skos:definition xml:lang="en">A model that represents the internal logical structure of the object.</skos:definition>
        <skos:example xml:lang="en">A physics equation is replicating the mechanisms internal to the object.</skos:example>
        <skos:example xml:lang="en">Electrical diagram is diagrammatic and resemblance</skos:example>
        <skos:example xml:lang="en">MODA and CHADA are diagrammatic representation of a simulation or a characterisation workflow.</skos:example>
        <skos:prefLabel xml:lang="en">AnalogicalModel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A model that focus on HOW the object works.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The subclass of model inspired by Peirceian category (b) the diagram, whose internal relations, mainly dyadic or so taken, represent by analogy (with the same logic) the relations in something (e.g. math formula, geometric flowchart).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#ArtificialIntelligenceModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#ArtificialIntelligenceModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MathematicalModel"/>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.researchgate.net/publication/350296216/figure/fig3/AS:11431281115851476@1675133526198/The-brief-classification-of-AI.png</rdfs:seeAlso>
        <skos:altLabel xml:lang="en">ArtificialIntelligence</skos:altLabel>
        <skos:definition xml:lang="en">A machine-based system that perceives its environment, pursues goals, adapts to feedback/change and provides information/takes action.</skos:definition>
        <skos:prefLabel xml:lang="en">ArtificialIntelligenceModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#ArtificialMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#ArtificialMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByOrigin"/>
        <skos:definition xml:lang="en">Any substance engineered or created by humans, often to mimic or improve upon natural materials.</skos:definition>
        <skos:prefLabel xml:lang="en">ArtificialMaterial</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Artificial materials are typically engineered through chemical synthesis from natural raw materials like oil or coal, resulting in polymers such as plastics, nylon, or polyester, designed for specific, enhanced properties like strength, durability, or moldability not found in nature.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Atom -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Atom">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MolecularEntity"/>
        <skos:altLabel xml:lang="en">ChemicalElement</skos:altLabel>
        <skos:definition xml:lang="en">A standalone atom has direct part one &apos;nucleus&apos; and one &apos;electron_cloud&apos;.

An O &apos;atom&apos; within an O₂ &apos;molecule&apos; is an &apos;e-bonded_atom&apos;.

In this material branch, H atom is a particular case, with respect to higher atomic number atoms, since as soon as it shares its electron it has no nucleus entangled electron cloud.

We cannot say that H₂ molecule has direct part two H atoms, but has direct part two H nucleus.</skos:definition>
        <skos:prefLabel xml:lang="en">Atom</skos:prefLabel>
        <skos:scopeNote xml:lang="en">An &apos;atom&apos; is a &apos;nucleus&apos; surrounded by an &apos;electron_cloud&apos;, i.e. a quantum system made of one or more bounded electrons.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#AtomicInteractionModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#AtomicInteractionModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#AtomisticModel"/>
        <skos:definition xml:lang="en">A physics-based model based on a physics equation describing the interaction between atoms.</skos:definition>
        <skos:prefLabel xml:lang="en">AtomicInteractionModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#AtomisticModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#AtomisticModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialsModel"/>
        <skos:example xml:lang="en">A physics-based model based on a physics equation describing the behaviour of atoms.</skos:example>
        <skos:prefLabel xml:lang="en">AtomisticModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#AtomisticMolecularDynamics -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#AtomisticMolecularDynamics">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#AtomisticModel"/>
        <skos:definition xml:lang="en">Atomistic model that models the physical movements of atoms and molecules over time by numerically solving Newton’s equations of motion.</skos:definition>
        <skos:prefLabel xml:lang="en">AtomisticMolecularDynamics</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#BondedAtom -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#BondedAtom">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Atom"/>
        <skos:definition xml:lang="en">A bonded atom that shares at least one electron to the atom-based entity of which is part of.</skos:definition>
        <skos:prefLabel xml:lang="en">BondedAtom</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A real bond between atoms is always something hybrid between covalent, metallic and ionic.

In general, metallic and ionic bonds have atoms sharing electrons.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The bond types that are covered by this definition are the strong electronic bonds: covalent, metallic and ionic.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">This class can be used to represent molecules as simplified quantum systems, in which outer molecule shared electrons are un-entangled with the inner shells of the atoms composing the molecule.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#CeramicMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#CeramicMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByType"/>
        <skos:altLabel xml:lang="en">Ceramic</skos:altLabel>
        <skos:definition xml:lang="en">An inorganic non-metallic solid made from elements (metals, non-metals, semi-metals like silicon) combined into compounds (oxides, carbides, nitrides) that are typically hard, strong, brittle, corrosion-resistant, and good insulators.</skos:definition>
        <skos:prefLabel xml:lang="en">CeramicMaterial</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Ceramic materials are hardened by intense heat and typically used from pottery and tiles to advanced electronics and aerospace parts.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#ChemicalCompound -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#ChemicalCompound">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ChemicalSubstance"/>
        <rdfs:seeAlso xml:lang="en">https://en.wikipedia.org/wiki/Chemical_compound</rdfs:seeAlso>
        <skos:definition xml:lang="en">A chemical substance composed of many identical molecules (or molecular entities) composed of atoms from more than one element held together by chemical bonds.</skos:definition>
        <skos:prefLabel xml:lang="en">ChemicalCompound</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#ChemicalEntity -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#ChemicalEntity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Matter"/>
        <skos:definition xml:lang="en">The union of ChemicalSubstance and MolecularEntity.</skos:definition>
        <skos:prefLabel xml:lang="en">ChemicalEntity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A chemical entity comprises the two different ways to represents matter: as single recognizable particle entity (molecular entity) and as a composition of particle entities (substance).

This distinction is not well assessed in actual chemical nomenclature, in which an element name refers to both the pure elemental substance or the atom.

In the EMMO we force the adoption of a more strict categorization based on mereotopology.

The class Material hosts the subclasses for which a substance can be identified without necessarily considering its nature of molecule/atom or substance (e.g. hydrocarbon is the class of both hydrocarbon molecules or gases).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#ChemicalSubstance -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#ChemicalSubstance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ChemicalEntity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Substance"/>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo/hume#MolecularEntity"/>
        <rdfs:seeAlso xml:lang="en">https://doi.org/10.1351/goldbook.C01039</rdfs:seeAlso>
        <skos:definition xml:lang="en">Matter of constant composition best characterized by the entities (molecules, formula units, atoms) it is composed of.</skos:definition>
        <skos:prefLabel xml:lang="en">ChemicalSubstance</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A chemical substance is always composed of more than one molecular entity. It lays in the continuum or mesoscopic domain.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#CompactMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#CompactMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByCompactness"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Solid"/>
        <skos:definition xml:lang="en">A solid material whose particles are closely and firmly packed together, resulting in a high density, solid structure without significant internal voids or cavities.</skos:definition>
        <skos:prefLabel xml:lang="en">CompactMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#CompositeMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#CompositeMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByType"/>
        <skos:altLabel xml:lang="en">Composite</skos:altLabel>
        <skos:definition xml:lang="en">A material that contains two or more constituent materials.</skos:definition>
        <skos:prefLabel xml:lang="en">CompositeMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#CondensedMatter -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#CondensedMatter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#StateOfMatter"/>
        <skos:definition xml:lang="en">Solid or liquid matter.</skos:definition>
        <skos:prefLabel xml:lang="en">CondensedMatter</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with &quot;condensed&quot; phases of matter: systems of many constituents with strong interactions between them.</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/hume#CondensedMatter"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget xml:lang="en">The subject of condensed matter physics that deals with the macroscopic and microscopic physical properties of matter, especially the solid and liquid phases which arise from electromagnetic forces between atoms. More generally, the subject deals with &quot;condensed&quot; phases of matter: systems of many constituents with strong interactions between them.</owl:annotatedTarget>
        <rdfs:seeAlso xml:lang="en">https://en.wikipedia.org/wiki/Condensed_matter_physics</rdfs:seeAlso>
    </owl:Axiom>
    


    <!-- https://w3id.org/emmo/hume#ContinuumModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#ContinuumModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialsModel"/>
        <skos:example xml:lang="en">A physics-based model based on a physics equation describing the behaviour of continuum volume.</skos:example>
        <skos:prefLabel xml:lang="en">ContinuumModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#ContinuumSubstance -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#ContinuumSubstance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Substance"/>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo/hume#MesoscopicSubstance"/>
        <skos:definition xml:lang="en">A state that is a collection of sufficiently large number of other parts such that:
- it is the bearer of qualities that can exists only by the fact that it is a sum of parts
- the smallest partition dV of the state volume in which we are interested in, contains enough parts to be statistically consistent: n [#/m3] x dV [m3] &gt;&gt; 1</skos:definition>
        <skos:prefLabel xml:lang="en">ContinuumSubstance</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A continuum is made of a sufficient number of parts that it continues to exists as continuum individual even after the loss of one of them i.e. a continuum is a redundant.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">A continuum is not necessarily small (i.e. composed by the minimum amount of sates to fulfill the definition).

A single continuum individual can be the whole fluid in a pipe.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">A continuum is the bearer of properties that are generated by the interactions of parts such as viscosity and thermal or electrical conductivity.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#CrystallineMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#CrystallineMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByStructure"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Solid"/>
        <skos:definition xml:lang="en">A solid where atoms, ions, or molecules are arranged in a highly ordered, repeating, three-dimensional pattern, forming a crystal lattice that extends throughout the substance, giving it characteristic geometric shapes and distinct physical properties like sharp melting points, unlike amorphous solids with random structures.</skos:definition>
        <skos:prefLabel xml:lang="en">CrystallineMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#CumulativeHypergeometricTest -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#CumulativeHypergeometricTest">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#StatisticalTest"/>
        <skos:definition xml:lang="en">A statistical test that determines the statistical significance (p-value) of observing `k` or more/fewer successes in a sample drawn without replacement from a finite population. It tests if a subpopulation is over- or under-represented, often calculating `P(X&gt;=k)` or `P(X&lt;=k)`. It is essential for small populations where sampling changes probabilities.</skos:definition>
        <skos:prefLabel xml:lang="en">CumulativeHypergeometricTest</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#DataBasedModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#DataBasedModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MathematicalModel"/>
        <skos:definition xml:lang="en">A mathematical model based on observed data, measurements, or experimental results.</skos:definition>
        <skos:prefLabel xml:lang="en">DataBasedModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#DataProcessing -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#DataProcessing">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Computation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/hasParticipant"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/hume#DataProcessingSoftware"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:definition xml:lang="en">A computation that provides a data output following the elaboration of some input data, using a data processing application.</skos:definition>
        <skos:prefLabel xml:lang="en">DataProcessing</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#DataProcessingSoftware -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#DataProcessingSoftware">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Software"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/implementsModel"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/emmo/hume#MathematicalModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:altLabel xml:lang="en">DataProcessingApplication</skos:altLabel>
        <skos:definition xml:lang="en">A software program aimed for data processing.</skos:definition>
        <skos:prefLabel xml:lang="en">DataProcessingSoftware</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#ElectronicModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#ElectronicModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialsModel"/>
        <skos:definition xml:lang="en">A physics-based model based on a physics equation describing the behaviour of electrons.</skos:definition>
        <skos:example xml:lang="en">Density functional theory.
Hartree-Fock.</skos:example>
        <skos:prefLabel xml:lang="en">ElectronicModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#ElementalSubstance -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#ElementalSubstance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ChemicalSubstance"/>
        <rdfs:seeAlso xml:lang="en">https://doi.org/10.1351/goldbook.C01022</rdfs:seeAlso>
        <skos:altLabel xml:lang="en">PureSubstance</skos:altLabel>
        <skos:definition xml:lang="en">A chemical substance composed of atoms with the same number of protons in the atomic nucleus.</skos:definition>
        <skos:prefLabel xml:lang="en">ElementalSubstance</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Fluid -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Fluid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#StateOfMatter"/>
        <skos:definition xml:lang="en">A continuum that has no fixed shape and yields easily to external pressure.</skos:definition>
        <skos:example xml:lang="en">Gas, liquid, plasma,</skos:example>
        <skos:prefLabel xml:lang="en">Fluid</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#FunctionalIcon -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#FunctionalIcon">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Model"/>
        <skos:altLabel xml:lang="en">FunctionalIcon</skos:altLabel>
        <skos:definition xml:lang="en">A model that imitates one representative character of the object. It share external similarities with the object, but not necessarily the same internal logical structure.</skos:definition>
        <skos:example xml:lang="en">A data based model is only a functional model, since it provide the same relations between the properties of the object (e.g., it can predict some properties as function of others) but is not considering the internal mechanisms (i.e., it can ignore the physics).</skos:example>
        <skos:prefLabel xml:lang="en">FunctionalModel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A model that focusing WHAT the object does.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">This subclass of model inspired by Peirceian category (c) the metaphor, which represents the representative character of a sign by representing a parallelism in something else.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Gas -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Gas">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Fluid"/>
        <skos:definition xml:lang="en">Gas is a compressible fluid, a state of matter that has no fixed shape and no fixed volume.</skos:definition>
        <skos:prefLabel xml:lang="en">Gas</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#GenerativeAIModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#GenerativeAIModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DeepLearningModel"/>
        <skos:altLabel xml:lang="en">GenerativeArtificialIntelligenceModel</skos:altLabel>
        <skos:definition xml:lang="en">An AI model that can generate new content, like text, images or code.</skos:definition>
        <skos:example xml:lang="en">Chatbots</skos:example>
        <skos:prefLabel xml:lang="en">GenerativeAIModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#GranularMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#GranularMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByCompactness"/>
        <skos:definition xml:lang="en">A granular material is a conglomeration of discrete solid, macroscopic particles that are  large enough to avoid thermal motion fluctuations, and characterized by a loss of energy whenever the particles interact.</skos:definition>
        <skos:prefLabel xml:lang="en">GranularMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#InorganicCompound -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#InorganicCompound">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ChemicalCompound"/>
        <rdfs:seeAlso xml:lang="en">https://en.wikipedia.org/wiki/Inorganic_compound</rdfs:seeAlso>
        <skos:definition xml:lang="en">A chemical compound that is not organic.</skos:definition>
        <skos:prefLabel xml:lang="en">InorganicCompound</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#IntentionalAgent -->


    <rdf:Description rdf:about="https://w3id.org/emmo/hume#IntentionalAgent">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    </rdf:Description>
    


    <!-- https://w3id.org/emmo/hume#IonAtom -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#IonAtom">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#StandaloneAtom"/>
        <owl:disjointWith rdf:resource="https://w3id.org/emmo/hume#NeutralAtom"/>
        <skos:definition xml:lang="en">A standalone atom with an unbalanced number of electrons with respect to its atomic number.</skos:definition>
        <skos:prefLabel xml:lang="en">IonAtom</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Liquid -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Liquid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#CondensedMatter"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Fluid"/>
        <skos:definition xml:lang="en">A liquid is a nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure.</skos:definition>
        <skos:prefLabel xml:lang="en">Liquid</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MachineLearningModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MachineLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#DataBasedModel"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/CognitionAndLearningModel"/>
        <rdfs:seeAlso>Hutter F, Kotthoff L, Vanschoren J (2019) Automated Machine Learning. Springer, New York.</rdfs:seeAlso>
        <skos:definition xml:lang="en">AI model that learns progressively by discovering implicit patterns and performing an intellectual task without explicit instructions in advance.</skos:definition>
        <skos:prefLabel xml:lang="en">MachineLearningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#ManufacturedMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#ManufacturedMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ArtificialMaterial"/>
        <skos:prefLabel xml:lang="en">ManufacturedMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Material -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Material">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Substance"/>
        <skos:definition xml:lang="en">The class of individuals standing for an amount of ordinary matter substance.</skos:definition>
        <skos:prefLabel xml:lang="en">Material</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A instance of a material (e.g. nitrogen) can represent any state of matter. The fact that the individual also belongs to other classes (e.g. Gas) would reveal the actual form in which the material is found.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">A material may be either a mesoscopic or a continuum substance.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">Material usually means some definite kind, quality, or quantity of matter, especially as intended for use.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MaterialByClassicalMaterialsScience -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MaterialByClassicalMaterialsScience">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Material"/>
        <skos:prefLabel xml:lang="en">MaterialByClassicalMaterialsScience</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MaterialByCompactness -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MaterialByCompactness">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Material"/>
        <skos:prefLabel xml:lang="en">MaterialByCompactness</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MaterialByForceResponse -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MaterialByForceResponse">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Material"/>
        <skos:prefLabel xml:lang="en">MaterialByForceResponse</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MaterialByFunction -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MaterialByFunction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Material"/>
        <skos:prefLabel xml:lang="en">MaterialByFunction</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MaterialByOrigin -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MaterialByOrigin">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Material"/>
        <skos:prefLabel xml:lang="en">MaterialByOrigin</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MaterialBySize -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MaterialBySize">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Material"/>
        <skos:prefLabel xml:lang="en">MaterialBySize</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MaterialByStructure -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MaterialByStructure">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByClassicalMaterialsScience"/>
        <skos:prefLabel xml:lang="en">MaterialByStructure</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MaterialByType -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MaterialByType">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByClassicalMaterialsScience"/>
        <skos:definition xml:lang="en">Categorisation of matter by its type.</skos:definition>
        <skos:prefLabel xml:lang="en">MaterialByType</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MaterialsModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MaterialsModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#PhysicsBasedModel"/>
        <skos:definition xml:lang="en">A solvable set of one Physics Equation and one or more Materials Relations.</skos:definition>
        <skos:prefLabel xml:lang="en">MaterialsModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MathematicalModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MathematicalModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#AnalogicalIcon"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Information"/>
        <skos:definition xml:lang="en">An analogical model expressed in mathematical language.</skos:definition>
        <skos:prefLabel xml:lang="en">MathematicalModel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A mathematical model can be defined as a description of a system using mathematical concepts and language to facilitate proper explanation of a system or to study the effects of different components and to make predictions on patterns of behaviour.

Abramowitz and Stegun, 1968</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MesoscopicModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MesoscopicModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialsModel"/>
        <skos:example xml:lang="en">A physics-based model based on a physics equation describing the behaviour of mesoscopic entities, i.e. a set of bounded atoms like a molecule, bead or nanoparticle.</skos:example>
        <skos:prefLabel xml:lang="en">MesoscopicModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MesoscopicSubstance -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MesoscopicSubstance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Substance"/>
        <skos:definition xml:lang="en">A matter that is not a particulate matter and that does not fullfill the criteria of being a continuum substance.</skos:definition>
        <skos:example xml:lang="en">nanoparticle,
quantum dot,
carbon nanotupe</skos:example>
        <skos:prefLabel xml:lang="en">MesoscopicSubstance</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Mesoscopic substances typically exist on a length scale between atoms and molecules and macroscopic (bulk) substances. They are typically in the range of some nanometers to about a micrometer and often exhibit unique physical properties due to their size and shape.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MetallicMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MetallicMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByType"/>
        <skos:definition xml:lang="en">Inorganic substance, consisting of one or more metallic elements.</skos:definition>
        <skos:prefLabel xml:lang="en">MetallicMaterial</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Metallic materials are known for their shiny luster, excellent electrical/thermal conductivity, malleability (shapable by hammering), and ductility (can be drawn into wires), due to metallic bonding (shared electrons); they often form alloys (like steel from iron/carbon) to enhance these properties for diverse applications.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Mixture -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Mixture">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ContinuumSubstance"/>
        <skos:definition xml:lang="en">A continuum substance made up of two or more different substances which are physically (not chemically) combined.</skos:definition>
        <skos:prefLabel xml:lang="en">Mixture</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#MolecularEntity -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#MolecularEntity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ChemicalEntity"/>
        <rdfs:isDefinedBy xml:lang="en">https://goldbook.iupac.org/terms/view/M03986</rdfs:isDefinedBy>
        <skos:definition xml:lang="en">Any constitutionally or isotopically distinct atom, molecule, ion, ion pair, radical, radical ion, complex, conformer etc., identifiable as a separately distinguishable entity that can undergo a chemical reaction.</skos:definition>
        <skos:example xml:lang="en">Hydrogen molecule is an adequate definition of a certain molecular entity for some purposes, whereas for others it is necessary to distinguish the electronic state and/or vibrational state and/or nuclear spin, etc. of the hydrogen molecule.</skos:example>
        <skos:example xml:lang="en">Methane, may mean a single molecule of CH4 (molecular entity) or a molar amount, specified or not (chemical species), participating in a reaction. The degree of precision necessary to describe a molecular entity depends on the context.</skos:example>
        <skos:prefLabel xml:lang="en">MolecularEntity</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Molecular entity is used as a general term for singular entities, irrespective of their nature, while chemical species stands for sets or ensembles of molecular entities.

Note that the name of a compound may refer to the respective molecular entity or to the chemical species,</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Molecule -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Molecule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MolecularEntity"/>
        <skos:definition xml:lang="en">An atom-based state defined by an exact number of e-bonded atomic species and an electron cloud made of the shared electrons.</skos:definition>
        <skos:example xml:lang="en">H₂0, C₆H₁₂O₆, CH₄</skos:example>
        <skos:prefLabel xml:lang="en">Molecule</skos:prefLabel>
        <skos:scopeNote xml:lang="en">An entity is called essential if removing one direct part will lead to a change in entity class.
An entity is called redundant if removing one direct part will not lead to a change in entity class.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">This definition states that this object is a non-periodic set of atoms or a set with a finite periodicity.
Removing an atom from the state will result in another type of atom_based state.
e.g. you cannot remove H from H₂0 without changing the molecule type (essential). However, you can remove a C from a nanotube (redundant). C60 fullerene is a molecule, since it has a finite periodicity and is made of a well defined number of atoms (essential). A C nanotube is not a molecule, since it has an infinite periodicity (redundant).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#NanoMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#NanoMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialBySize"/>
        <skos:definition xml:lang="en">Material with any external dimension in the nanoscale or having internal structure or surface structure in the nanoscale, i.e. in the range of 1-100 nm.</skos:definition>
        <skos:prefLabel xml:lang="en">NanoMaterial</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The above definition comes from ISO 80004-1:2023.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#NaturalLanguageProcessingModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#NaturalLanguageProcessingModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/PerceptionModel"/>
        <skos:definition xml:lang="en">An AI model that understands and generates human language.</skos:definition>
        <skos:example xml:lang="en">Chatbots</skos:example>
        <skos:prefLabel xml:lang="en">NaturalLanguageProcessingModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#NaturalMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#NaturalMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByOrigin"/>
        <skos:definition xml:lang="en">A Material occurring in nature, without the need of human intervention.</skos:definition>
        <skos:prefLabel xml:lang="en">NaturalMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#NeutralAtom -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#NeutralAtom">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#StandaloneAtom"/>
        <skos:definition xml:lang="en">A standalone atom that has no net charge.</skos:definition>
        <skos:prefLabel xml:lang="en">NeutralAtom</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#OrganicCompound -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#OrganicCompound">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ChemicalCompound"/>
        <rdfs:seeAlso xml:lang="en">https://en.wikipedia.org/wiki/Organic_compound</rdfs:seeAlso>
        <skos:definition xml:lang="en">A chemical compound containing carbon atoms.</skos:definition>
        <skos:prefLabel xml:lang="en">OrganicCompound</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The definition of organic compound is based on the IUPAC Gold Book. However, sometimes an organic compound is defined as a chemical compound that contains a carbon-hydrogen or carbon-carbon bond. Also, some carbon-containing compounds are typically not classified as organic, like carbides, carbonates, and cyanides.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#PhaseOfMatter -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#PhaseOfMatter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ContinuumSubstance"/>
        <skos:altLabel xml:lang="en">Phase</skos:altLabel>
        <skos:definition xml:lang="en">A matter object throughout which all physical properties of a material are essentially uniform.</skos:definition>
        <skos:prefLabel xml:lang="en">PhaseOfMatter</skos:prefLabel>
        <skos:scopeNote xml:lang="en">In the physical sciences, a phase is a region of space (a thermodynamic system), throughout which all physical properties of a material are essentially uniform. Examples of physical properties include density, index of refraction, magnetization and chemical composition. A simple description is that a phase is a region of material that is chemically uniform, physically distinct, and (often) mechanically separable. In a system consisting of ice and water in a glass jar, the ice cubes are one phase, the water is a second phase, and the humid air is a third phase over the ice and water. The glass of the jar is another separate phase.

The term phase is sometimes used as a synonym for state of matter, but there can be several immiscible phases of the same state of matter. Also, the term phase is sometimes used to refer to a set of equilibrium states demarcated in terms of state variables such as pressure and temperature by a phase boundary on a phase diagram. Because phase boundaries relate to changes in the organization of matter, such as a change from liquid to solid or a more subtle change from one crystal structure to another, this latter usage is similar to the use of &quot;phase&quot; as a synonym for state of matter. However, the state of matter and phase diagram usages are not commensurate with the formal definition given above and the intended meaning must be determined in part from the context in which the term is used.</skos:scopeNote>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/emmo/hume#PhaseOfMatter"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2004/02/skos/core#scopeNote"/>
        <owl:annotatedTarget xml:lang="en">In the physical sciences, a phase is a region of space (a thermodynamic system), throughout which all physical properties of a material are essentially uniform. Examples of physical properties include density, index of refraction, magnetization and chemical composition. A simple description is that a phase is a region of material that is chemically uniform, physically distinct, and (often) mechanically separable. In a system consisting of ice and water in a glass jar, the ice cubes are one phase, the water is a second phase, and the humid air is a third phase over the ice and water. The glass of the jar is another separate phase.

The term phase is sometimes used as a synonym for state of matter, but there can be several immiscible phases of the same state of matter. Also, the term phase is sometimes used to refer to a set of equilibrium states demarcated in terms of state variables such as pressure and temperature by a phase boundary on a phase diagram. Because phase boundaries relate to changes in the organization of matter, such as a change from liquid to solid or a more subtle change from one crystal structure to another, this latter usage is similar to the use of &quot;phase&quot; as a synonym for state of matter. However, the state of matter and phase diagram usages are not commensurate with the formal definition given above and the intended meaning must be determined in part from the context in which the term is used.</owl:annotatedTarget>
        <rdfs:seeAlso xml:lang="en">https://en.wikipedia.org/wiki/Phase_(matter)</rdfs:seeAlso>
    </owl:Axiom>
    


    <!-- https://w3id.org/emmo/hume#PhysicalConstant -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#PhysicalConstant">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#PhysicalQuantity"/>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#PhysicalQuantity -->


    <rdf:Description rdf:about="https://w3id.org/emmo/hume#PhysicalQuantity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Property"/>
    </rdf:Description>
    


    <!-- https://w3id.org/emmo/hume#PhysicsBasedModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#PhysicsBasedModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MathematicalModel"/>
        <rdfs:isDefinedBy xml:lang="en">CEN Workshop Agreement, CWA 17284 Materials modelling - terminology, classification and metadata</rdfs:isDefinedBy>
        <skos:definition xml:lang="en">A mathematical model based on a fundamental physics theory which defines the relations between physics quantities of an entity.</skos:definition>
        <skos:prefLabel xml:lang="en">PhysicsBasedModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#PhysicsEquation -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#PhysicsEquation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#PhysicsBasedModel"/>
        <skos:definition xml:lang="en">An &apos;equation&apos; that stands for a &apos;physical_law&apos; by mathematically defining the relations between physics_quantities.</skos:definition>
        <skos:example xml:lang="en">The Newton&apos;s equation of motion.
The Schrödinger equation.
The Navier-Stokes equation.</skos:example>
        <skos:prefLabel xml:lang="en">PhysicsEquation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Plasma -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Plasma">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Fluid"/>
        <skos:definition xml:lang="en">A fluid in which a gas is ionized to a level where its electrical conductivity allows long-range electric and magnetic fields to dominate its behaviour.</skos:definition>
        <skos:prefLabel xml:lang="en">Plasma</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#PolyAtomicEntity -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#PolyAtomicEntity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MolecularEntity"/>
        <skos:definition xml:lang="en">An entity made of two or more bonded atoms.</skos:definition>
        <skos:prefLabel xml:lang="en">PolyAtomicEntity</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#PolymericMaterial -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#PolymericMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByType"/>
        <skos:definition xml:lang="en">A substance made of macromolecules formed by linking many smaller, repeating chemical units called monomers into long chains or networks, resulting in unique properties like toughness, elasticity, or flexibility, found in both natural forms (like DNA, protein) and synthetic plastics, rubbers, and fibers.</skos:definition>
        <skos:prefLabel xml:lang="en">PolymericMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Powder -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Powder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#GranularMaterial"/>
        <rdfs:isDefinedBy xml:lang="en">Duran, J., Reisinger A., Sands, Powders, and Grains: An Introduction to the Physics of Granular Materials. November 1999, Springer-Verlag New York, Inc., New York, ISBN 0-387-98656-1.</rdfs:isDefinedBy>
        <skos:definition xml:lang="en">A powder is a granular material composed of many very fine dry solid particles that may flow freely when shaken or tilted.</skos:definition>
        <skos:prefLabel xml:lang="en">Powder</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Replica -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Replica">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#FunctionalIcon"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ResemblanceIcon"/>
        <skos:definition xml:lang="en">A model that not only resembles the object, but also can express some of the object&apos;s functions.</skos:definition>
        <skos:example xml:lang="en">A small scale replica of a plane tested in a wind gallery shares the same functionality in terms of aerodynamic behaviour of the bigger one.</skos:example>
        <skos:example xml:lang="en">Pinocchio is a functional model of a boy since it imitates the external behaviour without having the internal biological structure of a human being (it is made of magic wood...).</skos:example>
        <skos:prefLabel xml:lang="en">Replica</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#ResemblanceIcon -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#ResemblanceIcon">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Model"/>
        <skos:altLabel xml:lang="en">ResemblanceIcon</skos:altLabel>
        <skos:definition xml:lang="en">A model that mimics the spatial or temporal shape of the object.</skos:definition>
        <skos:example xml:lang="en">A geographical map that imitates the shape of the landscape and its properties at a specific historical time.</skos:example>
        <skos:prefLabel xml:lang="en">ResemblanceModel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A model that focus on WHERE/WHEN the object is, in the sense of spatial or temporal shape.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The subclass of model inspired by Peirceian category a) the image, which depends on a simple quality (e.g. picture).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Solid -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Solid">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#CondensedMatter"/>
        <skos:definition xml:lang="en">A continuum characterized by structural rigidity and resistance to changes of shape or volume, that retains its shape and density when not confined.</skos:definition>
        <skos:prefLabel xml:lang="en">Solid</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#StandaloneAtom -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#StandaloneAtom">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Atom"/>
        <skos:definition xml:lang="en">An atom that does not share electrons with other atoms.</skos:definition>
        <skos:prefLabel xml:lang="en">StandaloneAtom</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#StateOfMatter -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#StateOfMatter">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ContinuumSubstance"/>
        <skos:definition xml:lang="en">A superclass made as the disjoint union of all the form under which matter can exist.</skos:definition>
        <skos:prefLabel xml:lang="en">StateOfMatter</skos:prefLabel>
        <skos:scopeNote xml:lang="en">In physics, a state of matter is one of the distinct forms in which matter can exist. Four states of matter are observable in everyday life: solid, liquid, gas, and plasma.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#StatisticalModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#StatisticalModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MathematicalModel"/>
        <skos:definition xml:lang="en">A mathematical model that embodies a set of statistical assumptions concerning the generation of sample data (and similar data from a larger population).</skos:definition>
        <skos:prefLabel xml:lang="en">StatisticalModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#StatisticalTest -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#StatisticalTest">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#StatisticalModel"/>
        <skos:definition xml:lang="en">A statistical model for analyzing data to determine if research results are significant and to decide whether to reject the null hypothesis, assessing if findings occurred by chance.</skos:definition>
        <skos:prefLabel xml:lang="en">StatisticalTest</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#StructureManipulationModel -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#StructureManipulationModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#AtomisticModel"/>
        <skos:definition xml:lang="en">A physics based model that manipulates atomic structures.</skos:definition>
        <skos:prefLabel xml:lang="en">StructureManipulationModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#Substance -->


    <owl:Class rdf:about="https://w3id.org/emmo/hume#Substance">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Matter"/>
        <skos:definition xml:lang="en">A matter entity characterised by the fact that it possesses some homogeneous properties or identification criteria.</skos:definition>
        <skos:example xml:lang="en">A litre of water.</skos:example>
        <skos:example xml:lang="en">A pen can be classified as a substance (although it has parts with different properties) since it can be identified as being solid.</skos:example>
        <skos:prefLabel xml:lang="en">Substance</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/emmo/hume#UnintentionalAgent -->


    <rdf:Description rdf:about="https://w3id.org/emmo/hume#UnintentionalAgent">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    </rdf:Description>
    


    <!-- https://w3id.org/ssbd/AbductiveReasoningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/AbductiveReasoningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/CognitionAndLearningModel"/>
        <skos:definition xml:lang="en">Identifies the most plausible explanation for incomplete observations.
Analogical Reasoning</skos:definition>
        <skos:prefLabel xml:lang="en">AbductiveReasoningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/AcidificationImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/AcidificationImpactAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory"/>
        <skos:altLabel xml:lang="en">Acidification Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">The acidification impact category in a Life Cycle Assessment (LCA) provides assessment of the environmental damage caused by acidifying emissions, such as sulphur and nitrogen compounds released into the air.</skos:definition>
        <skos:prefLabel xml:lang="en">AcidificationImpactCategory</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/AcuteToxicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/AcuteToxicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <terms:source>https://joint-research-centre.ec.europa.eu/projects-and-activities/reference-and-measurement/european-union-reference-laboratories/eu-reference-laboratory-alternatives-animal-testing-eurl-ecvam/alternative-methods-toxicity-testing/validated-test-methods-health-effects/acute-toxicity_en</terms:source>
        <skos:altLabel xml:lang="en">Acute Toxicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of the general toxic effects of a single dose or multiple doses of a chemical or product, within 24 hours by a particular route (oral, dermal, inhalation), and that occur during a subsequent 21-day observation period (to permit appearance of toxicity in susceptible organ system).</skos:definition>
        <skos:prefLabel xml:lang="en">AcuteToxicityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Adaboost -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Adaboost">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Classification"/>
        <skos:definition xml:lang="en">A supervised ensemble learning algorithm primarily used for classification and, less commonly, regression tasks.</skos:definition>
        <skos:prefLabel xml:lang="en">Adaboost</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/AdvancedMaterial -->


    <owl:Class rdf:about="https://w3id.org/ssbd/AdvancedMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ArtificialMaterial"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByFunction"/>
        <skos:definition xml:lang="en">A designed material tailored to simultaneously meet two or more pre-defined criteria.</skos:definition>
        <skos:prefLabel xml:lang="en">AdvancedMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/AmbientAirQualityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/AmbientAirQualityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ExposureAssessmentEnvironment"/>
        <skos:altLabel xml:lang="en">Ambient Air Quality Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing the concentration of air pollutants in ambient air.</skos:definition>
        <skos:prefLabel xml:lang="en">AmbientAirQualityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/AnalogicalReasoningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/AnalogicalReasoningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/CognitionAndLearningModel"/>
        <skos:definition xml:lang="en">Solves new problems by drawing parallels to known scenarios.</skos:definition>
        <skos:prefLabel xml:lang="en">AnalogicalReasoningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/AquaticToxicityFreshwater -->


    <owl:Class rdf:about="https://w3id.org/ssbd/AquaticToxicityFreshwater">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnvironmentalRiskAssessment"/>
        <terms:source>https://joint-research-centre.ec.europa.eu/projects-and-activities/reference-and-measurement/european-union-reference-laboratories/eu-reference-laboratory-alternatives-animal-testing-eurl-ecvam/alternative-methods-toxicity-testing/validated-test-methods-health-effects/aquatic-toxicity_en</terms:source>
        <skos:altLabel xml:lang="en">Aquatic Toxicity Freshwater</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of effects of a chemical on organisms living in freshwater; generally determined with organisms representing the three trophic levels: 1) Algae or plants, representing &quot;primary producers&quot;; 2) Invertebrates (e.g. crustaceans such as Daphnia spp.), representing &quot;primary consumers/secondary producers&quot;; 3) Vertebrates (usually fish), representing &quot;secondary consumers&quot;.</skos:definition>
        <skos:prefLabel xml:lang="en">AquaticToxicityFreshwater</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/AquaticToxicityMarine -->


    <owl:Class rdf:about="https://w3id.org/ssbd/AquaticToxicityMarine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnvironmentalRiskAssessment"/>
        <skos:altLabel xml:lang="en">Aquatic Toxicity Marine</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of effects of a chemical on organisms living in the marine environment.</skos:definition>
        <skos:prefLabel xml:lang="en">AquaticToxicityMarine</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ArtificialNeuralNetwork -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ArtificialNeuralNetwork">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MachineLearningModel"/>
        <skos:altLabel xml:lang="en">NeuralNetwork</skos:altLabel>
        <skos:definition xml:lang="en">AI model inspired by the human brain, featuring interconnected layers of artificial neurons that process data to recognize complex patterns, make predictions, and drive machine learning, especially in tasks like computer vision and natural language processing.</skos:definition>
        <skos:definition xml:lang="en">Neural networks learn by adjusting connection weights via training, with deep networks employing multiple layers for high-level abstraction.</skos:definition>
        <skos:prefLabel xml:lang="en">ArtificialNeuralNetwork</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Assessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Assessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Process"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/assesses"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/ns/prov#Entity"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/hasOutput"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/Property"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">assessment</rdfs:label>
        <skos:definition xml:lang="en">The process of evaluating the quality, performance, impact or other properties of a substance, product, or process. The result of an assessment is one or more properties.</skos:definition>
        <skos:prefLabel xml:lang="en">Assessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Autoencoder -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Autoencoder">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ArtificialNeuralNetwork"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DimensionalityReduction"/>
        <skos:definition xml:lang="en">Neural networks designed to compress input data into a lower-dimensional bottleneck layer and then reconstruct it, effectively learning efficient, non-linear representations.</skos:definition>
        <skos:prefLabel xml:lang="en">Autoencoder</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Bagging -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Bagging">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/PredictionLearningModel"/>
        <skos:definition xml:lang="en">A prediction learning meta-algorithm designed to improve the stability and accuracy of predictive models, specifically by reducing variance and helping to avoid overfitting.</skos:definition>
        <skos:prefLabel xml:lang="en">Bagging</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/BehaviorModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/BehaviorModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ArtificialIntelligenceModel"/>
        <skos:definition xml:lang="en">AI systems trained on vast, multimodal datasets—including video, sensor data, and action logs—to understand, predict, and simulate human-like actions and complex decision-making processes.</skos:definition>
        <skos:prefLabel xml:lang="en">BehaviorModel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Unlike LLMs that process text, LBMs focus on &quot;what people do,&quot; utilizing reinforcement learning to adapt to dynamic environments.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/BioaccumulationAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/BioaccumulationAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ExposureAssessmentEnvironment"/>
        <skos:altLabel xml:lang="en">Bioaccumulation Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing the bioaccumulation potential of a chemical.</skos:definition>
        <skos:prefLabel xml:lang="en">BioaccumulationAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Bioaccumulation refers to the accumulation of persistent hydrophobic chemicals in aquatic organisms through mechanisms such as direct uptake from water via gills or skin (bioconcentration), ingestion of suspended particles, or consumption of contaminated food (biomagnification). Bioaccumulation the progressive increase in the amount of a substance in an organism or part of an organism that occurs because the rate of intake from all contributing sources and by all possible routes exceeds the organism&apos;ss ability to eliminate the substance from its body. https://doi.org/10.1351/PAC-REC-08-07-09</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/BiocompatibleMaterial -->


    <owl:Class rdf:about="https://w3id.org/ssbd/BiocompatibleMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByFunction"/>
        <skos:definition xml:lang="en">Material designed to be biocompatible for implantation in the body, such as artificial joints or tissue scaffolds.</skos:definition>
        <skos:prefLabel xml:lang="en">BiocompatibleMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/BiodegradabilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/BiodegradabilityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ExposureAssessmentEnvironment"/>
        <skos:altLabel xml:lang="en">Biodegradability Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing the biodegradability of a chemical or material.</skos:definition>
        <skos:prefLabel xml:lang="en">BiodegradabilityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/BiodiversityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/BiodiversityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnvironmentalSustainabilityAssessment"/>
        <terms:source>https://doi.org/10.3732/ajb.1000296</terms:source>
        <skos:altLabel xml:lang="en">Biodiversity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Biodiversity assessments typically consist of identifying species and evaluating one or more metrics: (1) species richness (number of species), (2) evenness (ratio of various species), and/or (3) character diversity (phenotypic difference).</skos:definition>
        <skos:prefLabel xml:lang="en">BiodiversityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/BooleanData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/BooleanData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SymbolicData"/>
        <rdfs:label xml:lang="en">boolean data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#boolean"/>
        <skos:definition xml:lang="en">A symbolic data representing a boolean number.</skos:definition>
        <skos:prefLabel xml:lang="en">BooleanData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Boosting -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Boosting">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/PredictionLearningModel"/>
        <skos:definition xml:lang="en">A prediction learning ensemble model designed to improve the predictive performance of models by converting multiple &quot;weak learners&quot; (models with low predictive power, often simple decision trees) into a single &quot;strong learner&quot;.</skos:definition>
        <skos:prefLabel xml:lang="en">Boosting</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/BulkModulusAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/BulkModulusAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/MechanicalPropertiesAssessment"/>
        <skos:altLabel xml:lang="en">Bulk Modulus Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of bulk modulus of materials.</skos:definition>
        <skos:prefLabel xml:lang="en">BulkModulusAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ByteData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ByteData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ShortData"/>
        <rdfs:label xml:lang="en">byte data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#byte"/>
        <skos:definition xml:lang="en">A data representing a 8-bit integer number.</skos:definition>
        <skos:prefLabel xml:lang="en">ByteData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/CarcinogenicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/CarcinogenicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <terms:source>https://doi.org/10.1039/9781782623724</terms:source>
        <skos:altLabel xml:lang="en">Carcinogenicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Test(s) carried out over a sufficient time to detect any possible carcinogenic effect of a test substance.</skos:definition>
        <skos:prefLabel xml:lang="en">CarcinogenicityAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Carcinogenicity is the ability of chemical, physical, or biological agents, to induce or promote malignant neoplasms, and thus cancer.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Classification -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Classification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SupervisedLearningModel"/>
        <skos:definition xml:lang="en">A supervised learning model that trains models using labeled data to categorize new, unseen data into predefined classes.</skos:definition>
        <skos:prefLabel xml:lang="en">Classification</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Clustering -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Clustering">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/UnsupervicedLearningModel"/>
        <skos:definition xml:lang="en">An unsupervised learning model that automatically groups unlabeled data into clusters based on similarities in their features.</skos:definition>
        <skos:prefLabel xml:lang="en">Clustering</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/CognitionAndLearningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/CognitionAndLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ArtificialIntelligenceModel"/>
        <skos:altLabel xml:lang="en">Blends artificial intelligence with cognitive science to simulate human thought processes (sensing, reasoning, and learning) rather than just executing predefined rules.</skos:altLabel>
        <skos:altLabel xml:lang="en">CognitiveAI</skos:altLabel>
        <skos:prefLabel xml:lang="en">CognitionAndLearningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/CollaborativeFiltering -->


    <owl:Class rdf:about="https://w3id.org/ssbd/CollaborativeFiltering">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/RecommenderSystem"/>
        <skos:definition xml:lang="en">A widely used recommender system model that primarily operates by leveraging similarities between users and items based on past interactions (like ratings or purchases).</skos:definition>
        <skos:prefLabel xml:lang="en">CollaborativeFiltering</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Computation -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Computation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Process"/>
        <rdfs:label xml:lang="en">computation</rdfs:label>
        <skos:definition xml:lang="en">A process that deals with quantitative symbols (i.e. symbols associated with a quantitative oriented language).</skos:definition>
        <skos:definition xml:lang="en">Copmutation</skos:definition>
        <skos:prefLabel xml:lang="en">Computation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ComputationalTool -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ComputationalTool">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Software"/>
        <rdfs:label xml:lang="en">computational tool</rdfs:label>
        <skos:definition xml:lang="en">A software that performs a computation.</skos:definition>
        <skos:example xml:lang="en">Gromacs is a computational tool that solves Newton&apos;s equations of motion.</skos:example>
        <skos:prefLabel xml:lang="en">ComputationalTool</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ComputerVision -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ComputerVision">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/PerceptionModel"/>
        <skos:altLabel xml:lang="en">MachineVision</skos:altLabel>
        <skos:definition xml:lang="en">AI system that is able to acquire, understand and use digital images to recognize activities, objects, and images.</skos:definition>
        <skos:prefLabel xml:lang="en">ComputerVision</skos:prefLabel>
        <skos:scopeNote xml:lang="en"></skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ContentExtraction -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ContentExtraction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NaturalLanguageUnderstanding"/>
        <skos:definition xml:lang="en">A natural language model tha tinvolves analyzing text to move beyond keyword matching, identifying the &quot;who, what, and why&quot; behind user input by extracting entities, themes, and semantic relationships.</skos:definition>
        <skos:prefLabel xml:lang="en">ContentExtraction</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ConvolutionNeuralNetwork -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ConvolutionNeuralNetwork">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DeepLearningModel"/>
        <skos:definition xml:lang="en">A type of deep learning based on feedforward neural network that learns features via filter (or kernel) optimization.</skos:definition>
        <skos:prefLabel xml:lang="en">ConvolutionNeuralNetwork</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Data -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Data">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label xml:lang="en">data</rdfs:label>
        <rdfs:seeAlso xml:lang="en">Luciano Floridi, &quot;Information - A very Short Introduction&quot;, Oxford University Press., (2010) ISBN 978-0199551378</rdfs:seeAlso>
        <skos:definition xml:lang="en">Contrast from variation of properties that is encoded by an agent and that can be decoded by another agent according to a specific rule.</skos:definition>
        <skos:prefLabel xml:lang="en">Data</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Dataset -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Dataset">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Data"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/hasPart"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/Datum"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">dataset</rdfs:label>
        <skos:definition xml:lang="en">Encoded data made of more than one datum.</skos:definition>
        <skos:prefLabel xml:lang="en">Dataset</skos:prefLabel>
        <skos:scopeNote xml:lang="en">An organised collection of (more than one) datum in computational format, published or curated and available for access or download in one or more representations.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/DateData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/DateData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SymbolicData"/>
        <rdfs:label xml:lang="en">date data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#date"/>
        <skos:definition xml:lang="en">A symbolic data representing date. Format: YYYY-MM-DD (followed by an optional time zone offset, e.g. +01:00 for Central Europe).</skos:definition>
        <skos:prefLabel xml:lang="en">DateData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/DateTimeData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/DateTimeData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SymbolicData"/>
        <rdfs:label xml:lang="en">date time data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#dateTime"/>
        <skos:definition xml:lang="en">A symbolic data representing datetime. Format: YYYY-MM-DDThh:mm:ss (followed by an optional time zone offset, e.g. +01:00 for Central Europe).</skos:definition>
        <skos:prefLabel xml:lang="en">DateTimeData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Datum -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Datum">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Data"/>
        <rdfs:label xml:lang="en">datum</rdfs:label>
        <skos:definition xml:lang="en">A self-consistent encoded data entity.</skos:definition>
        <skos:prefLabel xml:lang="en">Datum</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Datum is the building block of datasets.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/DecisionTree -->


    <owl:Class rdf:about="https://w3id.org/ssbd/DecisionTree">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Classification"/>
        <skos:definition xml:lang="en">A non-parametric, supervised learning algorithm used for both classification and regression tasks.</skos:definition>
        <skos:prefLabel xml:lang="en">DecisionTree</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/DeepFeedForwardNetwork -->


    <owl:Class rdf:about="https://w3id.org/ssbd/DeepFeedForwardNetwork">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DeepLearningModel"/>
        <skos:definition xml:lang="en">Foundational deep learning model that approximate complex functions by mapping inputs to outputs through multiple, unidirectional hidden layers.</skos:definition>
        <skos:prefLabel xml:lang="en">DeepFeedForwardNetwork</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/DeepLearningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/DeepLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ArtificialNeuralNetwork"/>
        <skos:definition xml:lang="en">Machine learning based on artificial neural networks with multiple layers (often hundreds) that simulate the human brain&apos;s structure to learn complex, non-linear patterns from vast datasets.</skos:definition>
        <skos:prefLabel xml:lang="en">DeepLearningModel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Deep learning powers modern AI in image recognition, NLP, and generative models, outperforming traditional algorithms.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/DensityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/DensityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/PhysicalPropertiesAssessment"/>
        <skos:altLabel xml:lang="en">Density Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of density of chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">DensityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Description -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Description">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Sign"/>
        <rdfs:label xml:lang="en">description</rdfs:label>
        <skos:definition xml:lang="en">A collection of properties that depicts an object.</skos:definition>
        <skos:prefLabel xml:lang="en">Description</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A description is not atomic in the sense that it is made of more than one property.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/DevelopmentalNeurotoxicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/DevelopmentalNeurotoxicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <skos:altLabel xml:lang="en">Developmental Neurotoxicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessments that allows detection of substance-induced changes in the structural or functional integrity of the nervous system of a developing organism.</skos:definition>
        <skos:prefLabel xml:lang="en">DevelopmentalNeurotoxicityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/DimensionalityReduction -->


    <owl:Class rdf:about="https://w3id.org/ssbd/DimensionalityReduction">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MachineLearningModel"/>
        <skos:definition xml:lang="en">AI model that transforms high-dimensional datasets into lower-dimensional representations while preserving essential information, mitigating the &quot;curse of dimensionality.</skos:definition>
        <skos:prefLabel xml:lang="en">DimensionalityReduction</skos:prefLabel>
        <skos:scopeNote xml:lang="en"></skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/DomainOfApplicabilityStatus -->


    <owl:Class rdf:about="https://w3id.org/ssbd/DomainOfApplicabilityStatus">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Property"/>
        <rdfs:label xml:lang="en">domain of applicability status</rdfs:label>
        <skos:definition xml:lang="en">A result of a model or software indicating whether an input is within the applicability domain of the model or software. Applicability domain refers to the range of conditions and limitations within which a model can be reliably applied. It is a critical factor in determining the accuracy and validity of a model, as it defines the scope of its predictions and identifies potential sources of uncertainty. The process of defining the applicability domain involves assessing the model&apos;s performance under different conditions and establishing the boundaries of its predictive capabilities.</skos:definition>
        <skos:prefLabel xml:lang="en">DomainOfApplicabilityStatus</skos:prefLabel>
        <skos:scopeNote xml:lang="en">It should take one of the following values: ssbd:undefined; ssbd:outOfDomain; ssbd:inDomain.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/DoubleData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/DoubleData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NumericalData"/>
        <rdfs:label xml:lang="en">double data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#double"/>
        <skos:definition xml:lang="en">A symbolic data representing a 64-bit floating point numbers incl. ±Inf, ±0, NaN.</skos:definition>
        <skos:prefLabel xml:lang="en">DoubleData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/DynamicProgramming -->


    <owl:Class rdf:about="https://w3id.org/ssbd/DynamicProgramming">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ReinforcedLearningModel"/>
        <skos:definition xml:lang="en"></skos:definition>
        <skos:definition xml:lang="en">A reinforced learning model for solving complex problems by breaking them down into smaller, simpler subproblems and storing the results to avoid redundant calculations.</skos:definition>
        <skos:prefLabel xml:lang="en">DynamicProgramming</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EconomicDimension -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EconomicDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SSbDDimension"/>
        <skos:altLabel xml:lang="en">Economic Dimension</skos:altLabel>
        <skos:definition xml:lang="en">The dimension of economic impact in the context of SSbD assessments.</skos:definition>
        <skos:prefLabel xml:lang="en">EconomicDimension</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EconomicSustainabilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EconomicSustainabilityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SustainabilityAssessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/assesses"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/EconomicSustainabilityDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:altLabel xml:lang="en">Economic Sustainability Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of economic sustainability aspects of chemicals and materials during production,  transport, use, and disposal.</skos:definition>
        <skos:prefLabel xml:lang="en">EconomicSustainabilityAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The superclass of all SSbD Assessments within the economic sustainability dimension.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EconomicSustainabilityDimension -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EconomicSustainabilityDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SSbDDimension"/>
        <skos:altLabel xml:lang="en">Economic Sustainability Dimension</skos:altLabel>
        <skos:definition xml:lang="en">The dimension of economic sustainability within the SSbD framework.</skos:definition>
        <skos:prefLabel xml:lang="en">EconomicSustainabilityDimension</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ElectronicMaterial -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ElectronicMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByFunction"/>
        <skos:definition xml:lang="en">A material for electronic applications, like silicon used in computer chips, solar cells, and circuits.</skos:definition>
        <skos:prefLabel xml:lang="en">ElectronicMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EndocrineToxicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EndocrineToxicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <skos:altLabel xml:lang="en">Endocrine Toxicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing effects on chemicals on the hormone systems in humans leading to reproductive, developmental, or metabolic adverse effect.</skos:definition>
        <skos:prefLabel xml:lang="en">EndocrineToxicityAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Endocrine toxicity results when a chemical interferes with the synthesis, secretion, transport, metabolism, binding action, or elimination of hormones necessary for endocrine functions resulting in loss of normal tissue function, development, growth, or reproduction.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EnergyConsumptionAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EnergyConsumptionAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnvironmentalSustainabilityAssessment"/>
        <skos:altLabel xml:lang="en">Energy Consumption Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing the energy consumption during the life cycle of chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">EnergyConsumptionAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EnergyMaterial -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EnergyMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByFunction"/>
        <skos:definition xml:lang="en">A material for energy applications, including energy generation, storage, and conversion, such as batteries, supercapacitors, and fuel cells.</skos:definition>
        <skos:prefLabel xml:lang="en">EnergyMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EnsembleLearningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EnsembleLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MachineLearningModel"/>
        <skos:definition xml:lang="en">A machine learning model that combines multiple individual models (often called base learners or weak learners) to produce a single, more accurate, and robust predictive model.</skos:definition>
        <skos:prefLabel xml:lang="en">EnsembleLearningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EnvironmentalDimension -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EnvironmentalDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SSbDDimension"/>
        <skos:definition xml:lang="en">The dimension of environmental impact in the context of SSbD assessments.</skos:definition>
        <skos:prefLabel xml:lang="en">EnvironmentalDimension</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EnvironmentalExternalitiesAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EnvironmentalExternalitiesAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ExternalitiesAssessment"/>
        <skos:altLabel xml:lang="en">Environmental Externalities Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of environmental externalities.</skos:definition>
        <skos:prefLabel xml:lang="en">EnvironmentalExternalitiesAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Environmental Externalities Assessment is the formal procedure used to quantify and evaluate the uncompensated costs or benefits that economic activities impose on the environment. These costs are not often reflected in market prices, leading to misallocation of resources and distorted economic incentives. The assessment aims to internalise these overlooked environmental impacts.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EnvironmentalRiskAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EnvironmentalRiskAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SafetyAssessment"/>
        <terms:source>https://doi.org/10.1039/9781782623724</terms:source>
        <skos:altLabel xml:lang="en">Environmental Risk Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Estimate of the probability that harm will result from a defined exposure to a substance in an environmental medium.</skos:definition>
        <skos:prefLabel xml:lang="en">EnvironmentalRiskAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Environmental Risk Assessment (ERA) focuses on the risks that chemicals pose to ecological organisms, including plants and forests.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EnvironmentalSustainabilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EnvironmentalSustainabilityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SustainabilityAssessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/assesses"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/EnvironmentalSustainabilityDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:altLabel xml:lang="en">Environmental Sustainability Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of environmental sustainability aspects of chemicals and materials during production, transport, use, and disposal.</skos:definition>
        <skos:prefLabel xml:lang="en">EnvironmentalSustainabilityAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The superclass of all SSbD Assessments within the  environmental sustainability dimension.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/EnvironmentalSustainabilityDimension -->


    <owl:Class rdf:about="https://w3id.org/ssbd/EnvironmentalSustainabilityDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SSbDDimension"/>
        <skos:altLabel xml:lang="en">Environmental Sustainability Dimension</skos:altLabel>
        <skos:definition xml:lang="en">The dimension of environmental sustainability within the  SSbD framework of chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">EnvironmentalSustainabilityDimension</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ExpertSystem -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ExpertSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/KnowledgeRepresentation"/>
        <skos:definition xml:lang="en">AI system that contains manually inputted rules and data to copy human decision-making abilities.</skos:definition>
        <skos:prefLabel xml:lang="en">ExpertSystem</skos:prefLabel>
        <skos:scopeNote xml:lang="en"></skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ExposureAssessmentEnvironment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ExposureAssessmentEnvironment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SafetyAssessment"/>
        <terms:source>https://doi.org/10.1351/PAC-REC-08-07-09</terms:source>
        <skos:altLabel xml:lang="en">Exposure Assessment Environment</skos:altLabel>
        <skos:definition xml:lang="en">Description of the presence and characteristics of contact between a contaminant and an ecological entity of concern, and a summary of this information in an exposure profile.</skos:definition>
        <skos:prefLabel xml:lang="en">ExposureAssessmentEnvironment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ExposureAssessmentHumanHealth -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ExposureAssessmentHumanHealth">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SafetyAssessment"/>
        <skos:altLabel xml:lang="en">Exposure Assessment Human Health</skos:altLabel>
        <skos:definition xml:lang="en">Estimates the magnitude, frequency, duration, and route of exposure to the chemical for humans or environment for the relevant exposure pattern (population, route, and duration of exposure) and each relevant health effect (local and systemic effects) under realistic or worst-case scenarios.</skos:definition>
        <skos:prefLabel xml:lang="en">ExposureAssessmentHumanHealth</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ExternalitiesAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ExternalitiesAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EconomicSustainabilityAssessment"/>
        <skos:altLabel xml:lang="en">Externalities Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Externalities assessment is the process of identifying, quantifying, and valuing the indirect costs or benefits of economic activities imposed on third parties€”such as environmental damage, pollution, health impacts, cultural heritage loss, loss of traditional livelihoods€”that are not reflected in market prices</skos:definition>
        <skos:prefLabel xml:lang="en">ExternalitiesAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ExtraTreesClassifier -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ExtraTreesClassifier">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Classification"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnsembleLearningModel"/>
        <skos:definition xml:lang="en">An ensemble learning model that builds multiple decision trees by choosing random splits for each node, rather than searching for the most discriminative threshold like Random Forest.</skos:definition>
        <skos:prefLabel xml:lang="en">ExtraTreesClassifier</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/FairRenumerationAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/FairRenumerationAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/WorkerSocialResponsibilityAssessment"/>
        <skos:altLabel xml:lang="en">Fair Renumeration</skos:altLabel>
        <skos:definition xml:lang="en">Assessing whether employees are paid as per their skills, experience, responsibilities, and performance. Fair pay ensures a decent lifestyle, to the extent that it covers the material, cultural and social needs generally perceived by people.</skos:definition>
        <skos:prefLabel xml:lang="en">FairRenumerationAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/FlammabiityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/FlammabiityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/IntrinsicChemicalHazardAssessment"/>
        <skos:altLabel xml:lang="en">Flammability  Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of flammability of chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">FlammabilityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/FloatData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/FloatData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NumericalData"/>
        <rdfs:label xml:lang="en">float data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#float"/>
        <skos:definition xml:lang="en">A symbolic data representing a 32-bit floating point numbers incl. ±Inf, ±0, NaN.</skos:definition>
        <skos:prefLabel xml:lang="en">FloatData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/FossilFuelEnergyConsumptionAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/FossilFuelEnergyConsumptionAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnergyConsumptionAssessment"/>
        <skos:altLabel xml:lang="en">Fossil Fuel Energy Consumption Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing the non-renewable energy consumption during the life cycle of chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">FossilFuelEnergyConsumptionAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/FreshwaterAquaticEcotoxicityImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/FreshwaterAquaticEcotoxicityImpactAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory"/>
        <skos:altLabel xml:lang="en">Freshwater Aquatic Ecotoxicity Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">Freshwater aquatic ecotoxicity in Life Cycle Assessment (LCA) is an environmental impact category measuring the potential toxic effects of chemical emissions (from product manufacturing, use, or disposal) on freshwater ecosystems.</skos:definition>
        <skos:prefLabel xml:lang="en">FreshwaterAquaticEcotoxicityImpactCategory</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/FreshwaterEutrophicationImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/FreshwaterEutrophicationImpactAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory"/>
        <skos:altLabel xml:lang="en">Freshwater Eutrophication Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">Freshwater Eutrophication  in Life Cycle Assessment (LCA) is an environmental impact category measuring the potential impacts of nutrient enrichment which causes detrimental overgrowth of biomass in freshwater ecosystems, leading to oxygen depletion and loss of species.</skos:definition>
        <skos:prefLabel xml:lang="en">FreshwaterEutrophicationImpactCategory</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/FunctionalityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/FunctionalityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SpecifiedAssessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/assesses"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/FunctionalityDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:altLabel xml:lang="en">Functionality Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of functionality of chemicals and materials.</skos:definition>
        <skos:definition xml:lang="en">The superclass of all SSbD Assessments within the dimenstion functionality.</skos:definition>
        <skos:prefLabel xml:lang="en">FunctionalityAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The superclass of all SSbD Assessments within the functionality dimension.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/FunctionalityDimension -->


    <owl:Class rdf:about="https://w3id.org/ssbd/FunctionalityDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SSbDDimension"/>
        <skos:altLabel xml:lang="en">Functionality Dimension</skos:altLabel>
        <skos:definition xml:lang="en">The dimension of functionality in the context of SSbD assessments.</skos:definition>
        <skos:prefLabel xml:lang="en">FunctionalityDimension</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The term functionality is defined as the quality of being useful, practical, and fit-for- purpose for which something was made. It is neither a property nor an application itself. It is rather the relationship between the use-oriented (functional) properties and the practical use of a chemical or material in such a way that the use of the chemical or material has a positive influence on a task or a potential application. https://www.oecd.org/en/publications/safe-and-sustainable-by-design-tools-integrative-systems-and-platforms-for-nanomaterials-and-nano-enabled-products_e411a4b7-en.html</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/GenerativeAdversarialNetwork -->


    <owl:Class rdf:about="https://w3id.org/ssbd/GenerativeAdversarialNetwork">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DeepLearningModel"/>
        <skos:definition xml:lang="en">A deep learning framework where two neural networks, the generator and discriminator, compete against each other to create new, synthetic instances of data (images, music, text) that resemble training data.</skos:definition>
        <skos:prefLabel xml:lang="en">GenerativeAdversarialNetwork</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/GenotoxicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/GenotoxicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <skos:altLabel xml:lang="en">Genotoxicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Tests which assesses whether a chemical or substance is genotoxic.</skos:definition>
        <skos:prefLabel xml:lang="en">GenotoxicityAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Genotoxic substances alter the structure, information content, or segregation of DNA, including those which cause DNA damage by interfering with normal replication processes, or which in a non-physiological manner (temporarily) alter its replication. https://doi.org/10.1039/9781782623724</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/GlassTransitionTemperatureAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/GlassTransitionTemperatureAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ThermalPropertiesAssessment"/>
        <skos:altLabel xml:lang="en">Glass Transition Temperature Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of glass transition temperature of materials.</skos:definition>
        <skos:prefLabel xml:lang="en">GlassTransitionTemperatureAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/GlobalWarmingAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/GlobalWarmingAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory"/>
        <skos:altLabel xml:lang="en">Global Warming Potential (GWP 100) Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">Global Warming Potential (GWP) impact category measures the potential increase in global temperature caused by greenhouse gas (GHG) emissions (e.g., methane) over  the time frame of 100 years.</skos:definition>
        <skos:prefLabel xml:lang="en">GlobalWarmingPotenial100</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/GraphBasedLearningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/GraphBasedLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SemiSupervicedLearningModel"/>
        <skos:altLabel xml:lang="en">GraphBasedAlgorithm</skos:altLabel>
        <skos:definition xml:lang="en">A semi-superviced machine learning paradigm that analyzes data structured as nodes and edges, exploiting topological relationships rather than treating data points as independent.</skos:definition>
        <skos:prefLabel xml:lang="en">GraphBasedLearningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/GraphNeuralNetwork -->


    <owl:Class rdf:about="https://w3id.org/ssbd/GraphNeuralNetwork">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DeepLearningModel"/>
        <skos:definition xml:lang="en">Deep learning model designed to analyze data represented as graphs with nodes (entities) and edges (relationships).</skos:definition>
        <skos:prefLabel xml:lang="en">GraphNeuralNetwork</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HHRAAirPollution -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HHRAAirPollution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HumanHealthRiskAssessment"/>
        <skos:altLabel xml:lang="en">HHRA Air Pollution</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of human health risks from air pollutants.</skos:definition>
        <skos:prefLabel xml:lang="en">HHRAAirPollution</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HHRAChemicalSubstances -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HHRAChemicalSubstances">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HumanHealthRiskAssessment"/>
        <skos:altLabel xml:lang="en">HHRA Chemical Substances</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of human health risks from pesticides, cosmetics, chemicals in flame retardants, etc. This can include dermal exposures, in addition to inhalation and ingestion exposure routes.</skos:definition>
        <skos:prefLabel xml:lang="en">HHRAChemicalSubstances</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HHRAIndoorAirPollution -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HHRAIndoorAirPollution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HumanHealthRiskAssessment"/>
        <skos:altLabel xml:lang="en">HHRA Indoor Air Pollution</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of human health risks from indoor air pollutants.</skos:definition>
        <skos:prefLabel xml:lang="en">HHRAIndoorAirPollution</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HHRASoilPollution -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HHRASoilPollution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HumanHealthRiskAssessment"/>
        <skos:altLabel xml:lang="en">HHRA  Soil Pollution</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of human health risks from pollutants in soil.</skos:definition>
        <skos:prefLabel xml:lang="en">HHRASoilPollution</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HHRAWaterPollution -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HHRAWaterPollution">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HumanHealthRiskAssessment"/>
        <skos:altLabel xml:lang="en">HHRA Water Pollution</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of human health risks from pollutants in  water.</skos:definition>
        <skos:prefLabel xml:lang="en">HHRAWaterPollution</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HazardAssessmentEnvironment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HazardAssessmentEnvironment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SafetyAssessment"/>
        <skos:altLabel xml:lang="en">Hazard Assessment Environment</skos:altLabel>
        <skos:definition xml:lang="en">Determination of factors controlling the likely effects of a hazard, such as the dose-effect and dose-response relationships, variations in target susceptibility, bioaccumulation potential, persistence, and mechanism of toxicity.</skos:definition>
        <skos:prefLabel xml:lang="en">HazardAssessmentEnvironment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HazardAssessmentHumanHealth -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HazardAssessmentHumanHealth">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SafetyAssessment"/>
        <skos:altLabel xml:lang="en">Hazard Assessment Human Health</skos:altLabel>
        <skos:definition xml:lang="en">Hazard Assessment is determination of factors controlling the likely effects of a hazard, such as the dose-effect and dose-response relationships, variations in target susceptibility, bioaccumulation potential, persistence, and mechanism of toxicity.</skos:definition>
        <skos:prefLabel xml:lang="en">HazardAssessmentHumanHealth</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HazardCharacterisationEnvironment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HazardCharacterisationEnvironment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardAssessmentEnvironment"/>
        <skos:altLabel xml:lang="en">Hazard Characterisation Environment</skos:altLabel>
        <skos:definition xml:lang="en">Component of risk assessment concerned with quantifying the manner in which the frequency and intensity of effects increase with increasing exposure of environmental organisms  to a contaminant or other source of stress.</skos:definition>
        <skos:prefLabel xml:lang="en">HazardCharacterisationEnvironment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Can also be labelled as dose-response assessment.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HazardCharacterisationHumanHealth -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HazardCharacterisationHumanHealth">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardAssessmentHumanHealth"/>
        <terms:source>https://doi.org/10.1039/9781782623724</terms:source>
        <skos:altLabel xml:lang="en">Hazard Characterisation Human Health</skos:altLabel>
        <skos:definition xml:lang="en">Hazard characterisation establishes the relationship between the dose or concentration of a chemical and the severity or probability of adverse effects. This includes identifying critical effects and determining reference tolerable exposure limit.</skos:definition>
        <skos:prefLabel xml:lang="en">HazardCharacterisationHumanHealth</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Qualitative and, wherever possible, quantitative description of the nature of the hazard associated the with the agent of concern.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HazardIdentificationEnvironment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HazardIdentificationEnvironment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SafetyAssessment"/>
        <skos:altLabel xml:lang="en">Hazard Identification Environment</skos:altLabel>
        <skos:definition xml:lang="en">Hazard identification is the process of determining whether exposure to a substance can cause a specific adverse effect on organisms in the environment</skos:definition>
        <skos:prefLabel xml:lang="en">HazardIdentificationEnvironment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HazardIdentificationHumanHealth -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HazardIdentificationHumanHealth">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardAssessmentHumanHealth"/>
        <terms:source>https://www.kemi.se/en/publications/guidance-on-national-chemicals-control-for-other-countries/hazard-and-risk-assessment-of-chemicals---an-introduction</terms:source>
        <skos:altLabel xml:lang="en">Hazard Identification Human Health</skos:altLabel>
        <skos:definition xml:lang="en">Hazard identification is the process of determining whether exposure to a substance can cause a specific adverse effect on human health. Adverse effect is defined as change in morphology, physiology, growth, reproduction, development, or lifespan of an organism which results in impairment of functional capacity or impairment of capacity to compensate for additional stress or increased susceptibility to the harmful effects of other environmental influences.</skos:definition>
        <skos:prefLabel xml:lang="en">HazardIdentificationHumanHealth</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HepatotoxicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HepatotoxicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <skos:altLabel xml:lang="en">Hepatotoxicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Tests which assess liver injury caused by chemicals or substances.</skos:definition>
        <skos:prefLabel xml:lang="en">HepatotoxicityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HeuristicLearningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HeuristicLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ReinforcedLearningModel"/>
        <skos:altLabel xml:lang="en">HeuristicMethod</skos:altLabel>
        <skos:definition xml:lang="en"></skos:definition>
        <skos:definition xml:lang="en">An experience-based, discovery-oriented reinforced learning model to problem-solving that uses &quot;rules of thumb,&quot; intuition, and mental shortcuts to find satisfactory solutions quickly when optimal ones are impractical.</skos:definition>
        <skos:prefLabel xml:lang="en">HeuristicLearningModel</skos:prefLabel>
        <skos:scopeNote xml:lang="en"></skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HumanHealthRiskAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HumanHealthRiskAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SafetyAssessment"/>
        <skos:altLabel xml:lang="en">Human Health Risk Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Human Health Risk Assessment integrates hazard and exposure information to estimate the likelihood and severity of harm to human health under specific use conditions.</skos:definition>
        <skos:prefLabel xml:lang="en">HumanHealthRiskAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HumanToxicityCancerImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HumanToxicityCancerImpactAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory"/>
        <skos:altLabel xml:lang="en">Human Carcinogenic Toxicity Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">Evaluating cancer risks caused by inhaling, ingesting, or absorbing chemical substances from environmental emissions (air, water, soil).</skos:definition>
        <skos:prefLabel xml:lang="en">HumanToxicityCancerImpactCategory</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/HumanToxicityNonCancerImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/HumanToxicityNonCancerImpactAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory"/>
        <skos:altLabel xml:lang="en">Human Noncarcinogenic Toxicity Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">Evaluating the adverse health effects on human, excluding cancer, caused by inhaling, ingesting, or absorbing chemical substances from environmental emissions (air, water, soil).</skos:definition>
        <skos:prefLabel xml:lang="en">HumanToxicityNonCancerImpactCategory</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ImageClassification -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ImageClassification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ComputerVision"/>
        <skos:definition xml:lang="en">A core computer vision task that assigns a predefined label or category to an entire image based on its visual content.</skos:definition>
        <skos:prefLabel xml:lang="en">ImageClassification</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ImageSegmentation -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ImageSegmentation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ComputerVision"/>
        <skos:definition xml:lang="en">Computer vision algorithm for partitioning a digital image into distinct, meaningful regions at the pixel level to identify object boundaries and simplify image analysis.</skos:definition>
        <skos:prefLabel xml:lang="en">ImageSegmentation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ImmunotoxicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ImmunotoxicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <skos:altLabel xml:lang="en">Immunotoxicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing the adverse effects of chemicals or substances on the immune system, causing immunosuppression, autoimmunity,  hypersensitivity, or immunomodulation.</skos:definition>
        <skos:prefLabel xml:lang="en">ImmunotoxicityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Indicator -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Indicator">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Property"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="https://w3id.org/ssbd/hasInput"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/IndicatorAssessment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">indicator</rdfs:label>
        <skos:definition xml:lang="en">A property that provides information about the state of a system. It simplifies complex realities into measurable values that can guide decisions.</skos:definition>
        <skos:example xml:lang="en">A thriving rhododhendron plant is and indicator of acidic soil.</skos:example>
        <skos:example xml:lang="en">Red cabbage turning green/yellow is an indicator of an alkaline solution.</skos:example>
        <skos:example xml:lang="en">The property pH is an indicator in a context when pH is indicative for something of particular interest.</skos:example>
        <skos:prefLabel xml:lang="en">Indicator</skos:prefLabel>
        <skos:scopeNote xml:lang="en">An indicator is input to a IndicatorAssessment activity that uses the indicator to say something about the state of a system.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/IndicatorAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/IndicatorAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Assessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/hasInput"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/Indicator"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/hasOutput"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/Sign"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">indicator assessment</rdfs:label>
        <skos:altLabel xml:lang="en">IndicatorEvaluation</skos:altLabel>
        <skos:definition xml:lang="en">An assessment that takes an indicator as input and produces a quantitative output that can be used to guide decisions.</skos:definition>
        <skos:prefLabel xml:lang="en">IndicatorAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">IndicatorAssessment is only expected to be used at individual level to avoid making the input property an indicator in a general scope.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The IndicatorAssessment class was introduced to provide a logically concise definition of Indicator such that it is possible for a reasoner to infer that any property that is input to an IndicatorAssessment must be an Indicator.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The produced output is a sign, that is either a single property or a collection of properties, (i.e. a description).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Information -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Information">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Data"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Sign"/>
        <rdfs:isDefinedBy xml:lang="en">Luciano Floridi, Information - A Very Short Introduction, Oxford University Press (2010) ISBN: 9780199551378</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">information</rdfs:label>
        <skos:definition xml:lang="en">Data with meaning (semiotic sign).</skos:definition>
        <skos:prefLabel xml:lang="en">Information</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/IntData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/IntData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LongData"/>
        <rdfs:label xml:lang="en">int data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#int"/>
        <skos:definition xml:lang="en">A data representing a 32-bit integer number.</skos:definition>
        <skos:prefLabel xml:lang="en">IntData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/IntegerData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/IntegerData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NumericalData"/>
        <rdfs:label xml:lang="en">integer data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#integer"/>
        <skos:definition xml:lang="en">A data representing an arbritrary sized integer number.</skos:definition>
        <skos:prefLabel xml:lang="en">IntegerData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Interpreter -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Interpreter">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:label xml:lang="en">interpreter</rdfs:label>
        <skos:definition xml:lang="en">The agent that connects the sign to an entity in a semiotic (meaning-making) process.</skos:definition>
        <skos:example xml:lang="en">A person (interpreter) that measures the length (sign) of an pencil (object).</skos:example>
        <skos:prefLabel xml:lang="en">Interpreter</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/IntrinsicChemicalHazardAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/IntrinsicChemicalHazardAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SafetyAssessment"/>
        <skos:altLabel xml:lang="en">Intrinsic Chemical Hazard Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Intrinsic Chemical Hazard Assessment is the systematic process of identifying and characterising the inherent harmful properties of a chemical substance, independent of exposure scenarios. This assessment focuses on the substance&apos;s capacity to cause adverse effects on human health or the environment under any circumstances.</skos:definition>
        <skos:prefLabel xml:lang="en">IntrinsicChemicalHazardAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/IrritationAndCorrosion -->


    <owl:Class rdf:about="https://w3id.org/ssbd/IrritationAndCorrosion">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <skos:altLabel xml:lang="en">Irritation and Corrosion</skos:altLabel>
        <skos:definition xml:lang="en">Assessing irritation and corrosive effects, i.e., surface-destructive effect on contact of chemicals on the skin, in the eyes or in respiratory system.</skos:definition>
        <skos:prefLabel xml:lang="en">IrritationAndCorrosion</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Skin corrosion refers to the production of irreversible damage to the skin; namely, visible necrosis  through the epidermis and into the dermis occurring after exposure to a substance or mixture. Skin irritation refers to the production of reversible damage to the skin occurring after exposure to a  substance or mixture. https://unece.org/transport/dangerous-goods/ghs-rev11-2025</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/KnowledgeRepresentation -->


    <owl:Class rdf:about="https://w3id.org/ssbd/KnowledgeRepresentation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/CognitionAndLearningModel"/>
        <rdfs:seeAlso>Liu HC, You JX, Li Z, Tian G (2017) Fuzzy Petri nets for knowledge representation and reasoning: A literature review. Eng Appl Artif Intell 60:45–56.</rdfs:seeAlso>
        <skos:definition xml:lang="en">Represent facts in the format of reusable knowledge. It combines a series of rules to simulate how a human brain functions through artificial means. It can make inferences and judgments based on knowledge provided by one or more experts and simulate human experts&apos; decision-making process.</skos:definition>
        <skos:prefLabel xml:lang="en">KnowledgeRepresentation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/LargeLanguageModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/LargeLanguageModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ModernGenerativeAIModel"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/TextGeneration"/>
        <skos:altLabel xml:lang="en">LLM</skos:altLabel>
        <skos:definition xml:lang="en">A specialized subset of Generative Artificial Intelligence that is fundamentally defined by its use of transformer architecture (specifically encoders, decoders, or both) to process and generate human-like text by predicting the next token in a sequence.</skos:definition>
        <skos:prefLabel xml:lang="en">LargeLanguageModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory -->


    <owl:Class rdf:about="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnvironmentalSustainabilityAssessment"/>
        <terms:source>https://www.iso.org/obp/ui/en/#iso:std:iso:14040:ed-2:v1:en</terms:source>
        <skos:altLabel xml:lang="en">Life Cycle Assessment Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">A LCA impact category is a class representing environmental issues of concern (including resource use) to which life cycle inventory analysis results may be assigned based on some common quality or qualities.</skos:definition>
        <skos:prefLabel xml:lang="en">LifeCycleAssessmentImpactCategory</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/LinearDiscriminantAnalysis -->


    <owl:Class rdf:about="https://w3id.org/ssbd/LinearDiscriminantAnalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DimensionalityReduction"/>
        <skos:definition xml:lang="en">A dimensionality reduction model used in classification tasks to find a feature subspace that maximizes class separability.</skos:definition>
        <skos:prefLabel xml:lang="en">LinearDiscriminantAnalysis</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Logic -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Logic">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/CognitionAndLearningModel"/>
        <skos:altLabel xml:lang="en">DeductiveReasoning</skos:altLabel>
        <skos:definition xml:lang="en">A AI system based on generic rules of the reasoning behind different cases of problem-solving.</skos:definition>
        <skos:example xml:lang="en">If A=B and B=C, then A=C</skos:example>
        <skos:prefLabel xml:lang="en">Logic</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/LogisticRegressionModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/LogisticRegressionModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/RegressionModel"/>
        <skos:definition xml:lang="en">A fundamental supervised machine learning algorithm used for classification, predicting the probability of a categorical dependent variable.</skos:definition>
        <skos:prefLabel xml:lang="en">LogisticRegressionModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/LongData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/LongData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/IntegerData"/>
        <rdfs:label xml:lang="en">long data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#long"/>
        <skos:definition xml:lang="en">A data representing a 64-bit integer number.</skos:definition>
        <skos:prefLabel xml:lang="en">LongData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/LowDensitySeparationModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/LowDensitySeparationModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SemiSupervicedLearningModel"/>
        <skos:definition xml:lang="en">A semi-supervised model where the decision boundary between classes is placed in a low-density region of the data distribution.</skos:definition>
        <skos:prefLabel xml:lang="en">LowDensitySeparationModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/MachineTranslation -->


    <owl:Class rdf:about="https://w3id.org/ssbd/MachineTranslation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NaturalLanguageUnderstanding"/>
        <skos:definition xml:lang="en">A natural language understanding model that enables machine translation to move beyond word-for-word substitution by analyzing intent, context, and semantic meaning.</skos:definition>
        <skos:prefLabel xml:lang="en">MachineTranslation</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/MacroMolecule -->


    <owl:Class rdf:about="https://w3id.org/ssbd/MacroMolecule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Molecule"/>
        <skos:definition xml:lang="en">A molecule with a specific weight larger than 5000 dalton.</skos:definition>
        <skos:prefLabel xml:lang="en">MacroMolecule</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/MagneticMaterial -->


    <owl:Class rdf:about="https://w3id.org/ssbd/MagneticMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByFunction"/>
        <skos:definition xml:lang="en">A material for magnetic applications, like for data storage, motors, and transformers (e.g., iron, ferrite).</skos:definition>
        <skos:prefLabel xml:lang="en">MagneticMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/MarineAquaticEcotoxicityImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/MarineAquaticEcotoxicityImpactAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory"/>
        <skos:altLabel xml:lang="en">Marine Aquatic Ecotoxicity Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">Marine aquatic ecotoxicity in Life Cycle Assessment (LCA) is an environmental impact category measuring the potential toxic effects of chemical emissions (from product manufacturing, use, or disposal) on marine ecosystems.</skos:definition>
        <skos:prefLabel xml:lang="en">MarineAquaticEcotoxicityImpactCategory</skos:prefLabel>
        <skos:scopeNote>This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/MarineEutrophicationImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/MarineEutrophicationImpactAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory"/>
        <skos:altLabel xml:lang="en">Marine Eutrophication Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">Marine Eutrophication in Life Cycle Assessment (LCA) is an environmental impact category measuring the potential impacts of nutrient enrichment in marine ecosystems leading to hypoxic waters causing far-reaching impacts, such as loss of biodiversity, habitat degradation, coral bleaching.</skos:definition>
        <skos:prefLabel xml:lang="en">MarineEutrophicationImpactCategory</skos:prefLabel>
        <skos:scopeNote>This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/MaterialProcess -->


    <owl:Class rdf:about="https://w3id.org/ssbd/MaterialProcess">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Process"/>
        <rdfs:label xml:lang="en">material process</rdfs:label>
        <skos:definition xml:lang="en">A process that has material as input and output.</skos:definition>
        <skos:prefLabel xml:lang="en">MaterialProcess</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Matter -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Matter">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label xml:lang="en">matter</rdfs:label>
        <skos:definition xml:lang="en">An entity that possess mass and occupies volume.</skos:definition>
        <skos:prefLabel xml:lang="en">Matter</skos:prefLabel>
        <skos:scopeNote xml:lang="en">From the definition it follows that matter is an object with fermionic parts.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">The interpretation of the term &quot;matter&quot; is not univocal. Several concepts are labelled with this term, depending on the field of science. The concept mass is sometimes related to the term &quot;matter&quot;, even if the former refers to a physical quantity (precisely defined by modern physics) while the latter is a type that qualifies a physical entity.
It is possible to identify more than one concept that can be reasonably labelled with the term &quot;matter&quot;. For example, it is possible to label as matter only the entities that are made up of atoms. Or more generally, we can be more fine-grained and call &quot;matter&quot; the entities that are made up of protons, neutrons or electrons, so that we can call matter also a neutron radiation or a cathode ray.
A more fundamental approach taken here, considers matter as entities that are made of quarks and leptons, without excluding particles like the W and Z bosons that possess some mass, but are not fermions. This definition also include antimatter.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Measurement -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Measurement">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Process"/>
        <rdfs:label xml:lang="en">measurement</rdfs:label>
        <skos:definition xml:lang="en">An observation that results in a quantitative comparison of a &apos;property&apos; of an &apos;object&apos; with a standard reference based on a well defined mesurement procedure.</skos:definition>
        <skos:prefLabel xml:lang="en">Measurement</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/MechanicalPropertiesAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/MechanicalPropertiesAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/FunctionalityAssessment"/>
        <skos:altLabel xml:lang="en">Mechanical Properties Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of mechanical properties of chemicals and materials.</skos:definition>
        <skos:definition xml:lang="en">Assessment of mechanical properties of materials.</skos:definition>
        <skos:prefLabel xml:lang="en">MechanicalPropertiesAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/MicroMolecule -->


    <owl:Class rdf:about="https://w3id.org/ssbd/MicroMolecule">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Molecule"/>
        <skos:altLabel xml:lang="en">MicroMolecule</skos:altLabel>
        <skos:definition xml:lang="en">A molecule with a specific weight smaller than 1000 dalton.</skos:definition>
        <skos:prefLabel xml:lang="en">SmallMolecule</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Model -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Model">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Sign"/>
        <rdfs:label xml:lang="en">model</rdfs:label>
        <skos:definition xml:lang="en">A useful simplified description of a selected part of the world.</skos:definition>
        <skos:example xml:lang="en">Newton&apos;s law of motion is a model for how a body will move when subjected to forces.
A mouse can be seen as a model for a human (e.g. in medicine).
An architectural floor plan is a model of a house.
</skos:example>
        <skos:prefLabel xml:lang="en">Model</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A model is a sign that resembles or imitates an object, in shape, function or by sharing a similar logical structure.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ModernGenerativeAIModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ModernGenerativeAIModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#GenerativeAIModel"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/TransformerAI"/>
        <skos:definition xml:lang="en">Generative AI based on the transformer architecture.</skos:definition>
        <skos:prefLabel xml:lang="en">ModernGenerativeAIModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/MonteCarloLearningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/MonteCarloLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ReinforcedLearningModel"/>
        <skos:altLabel xml:lang="en">MonteCarloMethod</skos:altLabel>
        <skos:definition xml:lang="en">A model-free reinforcement learning model that estimates value functions by averaging total returns from complete episodes of experience.</skos:definition>
        <skos:prefLabel xml:lang="en">MonteCarloLearningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/MutagenicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/MutagenicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <terms:source>https://doi.org/10.1039/9781782623724</terms:source>
        <skos:altLabel xml:lang="en">Mutagenicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Evaluating chemicals for mutagenic activity, i.e., chemicals which can induce (or generate) heritable changes (mutations) in the genotype in a cell as a consequence of alterations or loss of genes or chromosomes (or parts thereof).</skos:definition>
        <skos:prefLabel xml:lang="en">MutagenicityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NaiveBayes -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NaiveBayes">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Classification"/>
        <skos:definition xml:lang="en">A family of supervised learning algorithms used for classification problems, such as spam detection and sentiment analysis.</skos:definition>
        <skos:prefLabel xml:lang="en">NaiveBayes</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NanoComposite -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NanoComposite">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#CompositeMaterial"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NanoStructuredMaterial"/>
        <skos:definition xml:lang="en">A composite material with at least one physically or chemically distinct region or collection of regions having at least one dimension in the range of 1-100 nm.</skos:definition>
        <skos:prefLabel xml:lang="en">NanoComposite</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NanoFiber -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NanoFiber">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NanoObject"/>
        <skos:definition xml:lang="en">A material with two dimensions in the range of 1-100 nm.</skos:definition>
        <skos:prefLabel xml:lang="en">NanoFiber</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Nanofibers are often considered to be 1-dimensional nanomaterials.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NanoObject -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NanoObject">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#NanoMaterial"/>
        <skos:definition xml:lang="en">Material with any external dimension in the nanoscale, i.e. in the range of 1-100 nm.</skos:definition>
        <skos:prefLabel xml:lang="en">NanoObject</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NanoParticle -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NanoParticle">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NanoObject"/>
        <skos:definition xml:lang="en">A material with all dimensions in the range of 1-100 nm.</skos:definition>
        <skos:prefLabel xml:lang="en">NanoParticle</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Nanoparticles are often considered to be 0-dimensional nanomaterials.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NanoPlate -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NanoPlate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NanoObject"/>
        <skos:definition xml:lang="en">A material with one dimension in the range of 1-100 nm.</skos:definition>
        <skos:prefLabel xml:lang="en">NanoPlate</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Nanoplates are often considered to be 2-dimensional nanomaterials.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NanoRod -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NanoRod">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NanoFiber"/>
        <skos:definition xml:lang="en">A solid nanofiber.</skos:definition>
        <skos:prefLabel xml:lang="en">NanoRod</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NanoStructuredMaterial -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NanoStructuredMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#NanoMaterial"/>
        <skos:definition xml:lang="en">A material with at least one physically or chemically distinct region with at least one dimension in the range of 1-100 nm.</skos:definition>
        <skos:prefLabel xml:lang="en">NanoStructuredMaterial</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Nanostructured materials are considered to be 3-dimensional nanomaterials.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NanoTube -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NanoTube">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NanoFiber"/>
        <skos:definition xml:lang="en">A hollow nanofiber.</skos:definition>
        <skos:prefLabel xml:lang="en">NanoTube</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NaturalLanguageClassification -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NaturalLanguageClassification">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NaturalLanguageUnderstanding"/>
        <skos:definition xml:lang="en">A natural language understandig model that automatically assigns predefined categories, tags, or labels to unstructured text.</skos:definition>
        <skos:prefLabel xml:lang="en">NaturalLanguageClassification</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NaturalLanguageGeneration -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NaturalLanguageGeneration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#NaturalLanguageProcessingModel"/>
        <skos:definition xml:lang="en">A subfield of natural language processing (NLP) that automatically converts structured data or input into human-like written or spoken text.</skos:definition>
        <skos:prefLabel xml:lang="en">NaturalLanguageGeneration</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NaturalLanguageUnderstanding -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NaturalLanguageUnderstanding">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#NaturalLanguageProcessingModel"/>
        <skos:definition xml:lang="en">A subfield natural language processing (NLP) that enables machines to comprehend the intent, sentiment, and context behind human language.</skos:definition>
        <skos:prefLabel xml:lang="en">NaturalLanguageUnderstanding</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NeurotoxicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NeurotoxicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <terms:source>https://www.oecd.org/en/publications/guidance-document-for-neurotoxicity-testing_16d23a96-en.html</terms:source>
        <skos:altLabel xml:lang="en">Neurotoxicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing the adverse effects of chemicals or substances on the structure and function of the nervous system.</skos:definition>
        <skos:prefLabel xml:lang="en">NeurotoxicityAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Neurotoxicity (or a neurotoxic effect) is an adverse change in the structure or function of the nervous system that results from exposure to a chemical.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NonGenotoxicCarcinogenicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NonGenotoxicCarcinogenicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <skos:altLabel xml:lang="en">Non-genotoxic Carcinogenicity  Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Non-genotoxic carcinogenicity (NGTxC) assessment identifies cancer-causing agents that act through non-DNA-damaging mechanisms, such as hormonal effects, chronic inflammation, or epigenetic changes rather than direct mutation.</skos:definition>
        <skos:prefLabel xml:lang="en">NonGenotoxicCarcinogenicityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/NumericalData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/NumericalData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SymbolicData"/>
        <rdfs:label xml:lang="en">numerical data</rdfs:label>
        <skos:definition xml:lang="en">A symbolic data representing a numerical value.</skos:definition>
        <skos:prefLabel xml:lang="en">NumericalData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Object -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Object">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label xml:lang="en">object</rdfs:label>
        <skos:altLabel xml:lang="en">Continuant</skos:altLabel>
        <skos:altLabel xml:lang="en">Endurant</skos:altLabel>
        <skos:definition xml:lang="en">An entity that has a temporal extension.</skos:definition>
        <skos:prefLabel xml:lang="en">Object</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Object individals will typically also be an individual of &apos;Matter&apos;. However, when categorising something as an &apos;Object&apos;, the focus is on its existence (throughout one of more processes), while &apos;Matter&apos; focuses on that it pocess mass and takes up volume and how it can further be categorised as </skos:scopeNote>
        <skos:scopeNote xml:lang="en">Object is the class of all individuals who&apos;s temporal parts are of the same type as the whole.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ObjectDetection -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ObjectDetection">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ComputerVision"/>
        <skos:definition xml:lang="en">A computer vision model that combines image classification and localization to identify, label, and locate multiple objects within images or videos.</skos:definition>
        <skos:prefLabel xml:lang="en">ObjectDetection</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/OccupationalHealthandSafetyAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/OccupationalHealthandSafetyAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SocialSustainabilityAssessment"/>
        <skos:altLabel xml:lang="en">Occupational Health and Safety assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of occupational, health and safety of workers engaged in production and transportation of chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">OccupationalHealthandSafetyAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/OccupationalNonfatalInjuriesRate -->


    <owl:Class rdf:about="https://w3id.org/ssbd/OccupationalNonfatalInjuriesRate">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SafeWorkingConditionsAssessment"/>
        <skos:altLabel xml:lang="en">Occupational Non-fatal Injuries Rate</skos:altLabel>
        <skos:prefLabel xml:lang="en">OccupationalNonfatalInjuriesRate</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/OpticalMaterial -->


    <owl:Class rdf:about="https://w3id.org/ssbd/OpticalMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByFunction"/>
        <skos:definition xml:lang="en">A material for optical applications. Designed for specific interactions with light, such as fiber optics, lasers, or transparent coatings.</skos:definition>
        <skos:prefLabel xml:lang="en">OpticalMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/OxidisingPropetiesAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/OxidisingPropetiesAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/IntrinsicChemicalHazardAssessment"/>
        <skos:altLabel xml:lang="en">Oxidising Properties Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of oxidising properties of chemicals.</skos:definition>
        <skos:prefLabel xml:lang="en">OxidisingPropertiesAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Participant -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Participant">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Object"/>
        <rdfs:label xml:lang="en">participant</rdfs:label>
        <skos:definition xml:lang="en">An object that participates to a process.</skos:definition>
        <skos:example xml:lang="en">A student during an examination. The student exists both before and after the examination.</skos:example>
        <skos:prefLabel xml:lang="en">Participant</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Mereologically participation means that the object is a spatial part of the process.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/PerceptionModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/PerceptionModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ArtificialIntelligenceModel"/>
        <skos:altLabel xml:lang="en">KnowledgeBasedInferenceEngine</skos:altLabel>
        <skos:definition xml:lang="en">AI model that interact with the external world and process sensory information.</skos:definition>
        <skos:prefLabel xml:lang="en">PerceptionModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/PhotochemicalOzoneFormationAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/PhotochemicalOzoneFormationAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory"/>
        <skos:altLabel xml:lang="en">Photochemical ozone formation Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">This measures the potential of emissions like volatile organic compounds (VOCs) to form ground-level ozone, impacting human health and vegetation.</skos:definition>
        <skos:prefLabel xml:lang="en">PhotochemicalOzoneFormationImpactCategory</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/PhysicalPropertiesAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/PhysicalPropertiesAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/FunctionalityAssessment"/>
        <skos:altLabel xml:lang="en">Physical Properties Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of physical properties of chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">PhysicalPropertiesAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/PlanningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/PlanningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/CognitionAndLearningModel"/>
        <skos:altLabel xml:lang="en">Planning</skos:altLabel>
        <skos:definition xml:lang="en">System for intelligent planning and scheduling of tasks.</skos:definition>
        <skos:prefLabel xml:lang="en">PlanningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/PoissonsRatioAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/PoissonsRatioAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/MechanicalPropertiesAssessment"/>
        <skos:altLabel xml:lang="en">Poisson&apos;s Ratio Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of Poisson&apos;s ratio of materials.</skos:definition>
        <skos:prefLabel xml:lang="en">PoissonsRatioAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Poisson&apos;s ratio offers the fundamental metric by which to compare the performance of any material&apos;s resistance to distort under mechanical load rather than to alter in volume.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/PredictionLearningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/PredictionLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SupervisedLearningModel"/>
        <skos:altLabel xml:lang="en">PredictiveModelling</skos:altLabel>
        <skos:definition xml:lang="en">A branch of supervised learning that uses historical data, statistical algorithms, and data mining techniques to identify patterns and forecast future outcomes.</skos:definition>
        <skos:prefLabel xml:lang="en">PredictionLearningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/PrenatalDevelopmentalToxicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/PrenatalDevelopmentalToxicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <skos:altLabel xml:lang="en">Prenatal Developmental Toxicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Evaluation of potential adverse effects of prenatal exposure to substances on both the pregnant female and the developing organism.</skos:definition>
        <skos:prefLabel xml:lang="en">PrenatalDevelopmentalToxicityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/PrincipalComponentAnalysis -->


    <owl:Class rdf:about="https://w3id.org/ssbd/PrincipalComponentAnalysis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DimensionalityReduction"/>
        <skos:definition xml:lang="en">linear feature extraction model that transforms data into a new set of variables (principal components) that maximize variance.</skos:definition>
        <skos:prefLabel xml:lang="en">PrincipalComponentAnalysis</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ProbabilityModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ProbabilityModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/CognitionAndLearningModel"/>
        <rdfs:seeAlso>Anastasopoulos A, Chiang D, Duong L (2016) An unsupervised probability model for speech-to-translation alignment of low-resource languages. arXiv preprint arXiv:1609.08139.</rdfs:seeAlso>
        <skos:altLabel xml:lang="en">InductiveReasoning</skos:altLabel>
        <skos:definition xml:lang="en">AI system based on the probabilistic relationships between variables based on mathematical models.</skos:definition>
        <skos:prefLabel xml:lang="en">ProbabilityModel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Generalizes from specific observations, identifying patterns to predict outcomes (probabilistic).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Process -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Process">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:label xml:lang="en">process</rdfs:label>
        <skos:altLabel xml:lang="en">Occurent</skos:altLabel>
        <skos:altLabel xml:lang="en">Perdurant</skos:altLabel>
        <skos:definition xml:lang="en">An activity with temporal parts.</skos:definition>
        <skos:prefLabel xml:lang="en">Process</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The temporal parts of a process are not of the same type as the process itself.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Profiler -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Profiler">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Software"/>
        <rdfs:label xml:lang="en">profiler</rdfs:label>
        <skos:definition xml:lang="en">A software that identify the affiliation of the target chemical(s) to preliminary defined categories (functional groups/alerts).</skos:definition>
        <skos:prefLabel xml:lang="en">Profiler</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The outcome of the profiling determines the most appropriate way to search for analogues, but they are also useful for preliminary screening or prioritization of substances.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Property -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Property">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Sign"/>
        <rdfs:label xml:lang="en">property</rdfs:label>
        <skos:definition xml:lang="en">An &quot;atomic&quot; sign that stands for a characteristic of an object that can be observed or detected in a semiotic process.</skos:definition>
        <skos:prefLabel xml:lang="en">Property</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A property is atomic in the sense that is aimed to deliver one and one only aspect of the object.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Protein -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Protein">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#Molecule"/>
        <skos:definition xml:lang="en">A large molecule made of long chains of amino acids.</skos:definition>
        <skos:prefLabel xml:lang="en">Protein</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/QSARModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/QSARModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MathematicalModel"/>
        <rdfs:seeAlso rdf:resource="https://www.oecd.org/en/topics/sub-issues/assessment-of-chemicals/quantitative-structure-activity-relationships-project.html"/>
        <skos:definition xml:lang="en">A mathematical model (often a statistical correlation) relating one or more quantitative parameters derived from chemical structure to a quantitative measure of a property or activity (e.g. related to physical-chemical properties, ecotoxicology, environmental fate and transport, and human health hazards). QSARs are quantitative models yielding a continuous or categorical result.</skos:definition>
        <skos:prefLabel xml:lang="en">QSARModel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The aim of a QSAR model is typically to reduce time, monetary cost and needed animal testing.</skos:scopeNote>
        <skos:scopeNote xml:lang="en">To facilitate practical application of (Q)SAR approaches in regulatory contexts by governments and industry and to improve their regulatory acceptance, the OECD (Q)SAR project has developed various outcomes such as the principles for the validation of (Q)SAR models, guidance documents as well as the QSAR Toolbox.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/QSARSoftware -->


    <owl:Class rdf:about="https://w3id.org/ssbd/QSARSoftware">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Software"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/implementsModel"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/QSARModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">QSAR software</rdfs:label>
        <skos:definition xml:lang="en">A software implementing a QSAR model.</skos:definition>
        <skos:prefLabel xml:lang="en">QSARSoftware</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/QuestionAnswering -->


    <owl:Class rdf:about="https://w3id.org/ssbd/QuestionAnswering">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NaturalLanguageUnderstanding"/>
        <skos:definition xml:lang="en">A subfield of natural language processing and information retrieval that focuses on building systems capable of automatically answering questions posed by humans in natural language.</skos:definition>
        <skos:prefLabel xml:lang="en">QuestionAnswering</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/RandomForest -->


    <owl:Class rdf:about="https://w3id.org/ssbd/RandomForest">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/PredictionLearningModel"/>
        <skos:definition xml:lang="en">A prediction learning model for classification and regression that builds multiple decision trees during training.</skos:definition>
        <skos:prefLabel xml:lang="en">RandomForest</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/RecommenderSystem -->


    <owl:Class rdf:about="https://w3id.org/ssbd/RecommenderSystem">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SupervisedLearningModel"/>
        <skos:altLabel xml:lang="en">Recommendation</skos:altLabel>
        <skos:definition xml:lang="en">A information filtering system using supervised learning to suggest items most relevant to a particular user.</skos:definition>
        <skos:prefLabel xml:lang="en">RemommenderSystem</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/RecurrentNeuralNetwork -->


    <owl:Class rdf:about="https://w3id.org/ssbd/RecurrentNeuralNetwork">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DeepLearningModel"/>
        <skos:definition xml:lang="en">Neural network designed for sequential or time-series data, featuring feedback connections that allow information to persist.</skos:definition>
        <skos:prefLabel xml:lang="en">RecurrentNeuralNetwork</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/RegressionModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/RegressionModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SupervisedLearningModel"/>
        <skos:definition xml:lang="en">A supervised learning model used to predict continuous, numerical output values based on labeled training data.</skos:definition>
        <skos:prefLabel xml:lang="en">RegressionModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ReinforcedLearningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ReinforcedLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MachineLearningModel"/>
        <skos:altLabel xml:lang="en">ReinforcementLearning</skos:altLabel>
        <skos:definition xml:lang="en">A machine learning model where an intelligent &quot;agent&quot; learns to make optimal, sequential decisions by interacting with an environment, using trial-and-error to maximize cumulative rewards.</skos:definition>
        <skos:prefLabel xml:lang="en">ReinforcedLearningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/RenalToxicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/RenalToxicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <skos:altLabel xml:lang="en">Renal Toxicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing adverse effects on kidney from exposure to chemicals or substances.</skos:definition>
        <skos:prefLabel xml:lang="en">RenalToxicityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/RenewableEnergyConsumptionAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/RenewableEnergyConsumptionAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnergyConsumptionAssessment"/>
        <skos:altLabel xml:lang="en">Renewable Energy Consumption Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing the renewable energy consumption during the life cycle of chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">RenewableEnergyConsumptionAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ReproductiveToxicityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ReproductiveToxicityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <terms:source rdf:resource="https://www.oecd.org/en/publications/guidance-document-on-mammalian-reproductive-toxicity-testing-and-assessment_d2631d22-en.html"/>
        <skos:altLabel xml:lang="en">Reproductive Toxicity Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing if a chemical or substance interferes with reproductive function, including  fertility, and development of the foetus and embryo.</skos:definition>
        <skos:prefLabel xml:lang="en">ReproductiveToxicityAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Reproductive toxicity includes adverse effects on sexual function and fertility in adult males and females as well as developmental toxicity in the offspring.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ResourceAssessmentFossilFuel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ResourceAssessmentFossilFuel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnvironmentalSustainabilityAssessment"/>
        <skos:altLabel xml:lang="en">Fossil Fuel Resource Scarcity</skos:altLabel>
        <skos:definition xml:lang="en">Measuring the depletion of finite, non-renewable hydrocarbon resources (coal, oil, natural gas).</skos:definition>
        <skos:prefLabel xml:lang="en">ResourceAssessmentFossilFuel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ResourceAssessmentLand -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ResourceAssessmentLand">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnvironmentalSustainabilityAssessment"/>
        <skos:altLabel xml:lang="en">Land Use</skos:altLabel>
        <skos:definition xml:lang="en">Assessing the changes in soil quality  due to change in land use.</skos:definition>
        <skos:prefLabel xml:lang="en">ResourceAssessmentLand</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ResourceAssessmentMinerals -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ResourceAssessmentMinerals">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnvironmentalSustainabilityAssessment"/>
        <skos:altLabel xml:lang="en">Minerals Resource Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing surplus ore potential.</skos:definition>
        <skos:prefLabel xml:lang="en">ResourceAssessmentMinerals</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ResourceAssessmentWater -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ResourceAssessmentWater">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnvironmentalSustainabilityAssessment"/>
        <skos:altLabel xml:lang="en">Water Resource Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Quantification of the reduction in  freshwater availability and assessing impact of water stress on human health.</skos:definition>
        <skos:prefLabel xml:lang="en">ResourceAssessmentWater</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SSbDAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SSbDAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Assessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/assesses"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/SSbDDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/hasPart"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/SpecifiedAssessment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:altLabel xml:lang="en">SSbD Assessment</rdfs:altLabel>
        <rdfs:label xml:lang="en">SSbD assessment</rdfs:label>
        <skos:definition xml:lang="en">An assessment of the safety and sustainability of chemicals and materials across their life cycle. Assesses one or more ssbd dimension, through one ore more SSbDSpecifiedAssessments</skos:definition>
        <skos:prefLabel xml:lang="en">SSbDAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SSbDDimension -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SSbDDimension">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Sign"/>
        <terms:source>https://www.oecd.org/content/dam/oecd/en/publications/reports/2022/10/sustainability-and-safe-and-sustainable-by-design-working-descriptions-for-the-safer-innovation-approach_1ba68750/a9a80171-en.pdf</terms:source>
        <rdfs:label xml:lang="en">SSbD dimension</rdfs:label>
        <skos:altLabel>Safe and Sustainable by Design Dimension</skos:altLabel>
        <skos:definition xml:lang="en">The superclass of all dimensions relevant for SSbD assessments. Such dimensions can be considered thematic areas.</skos:definition>
        <skos:prefLabel xml:lang="en">SSbDDimension</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SafeWorkingConditionsAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SafeWorkingConditionsAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/OccupationalHealthandSafetyAssessment"/>
        <skos:altLabel xml:lang="en">Safe Working Conditions Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing safety performance in manufacturing  facilities using various Key Performance Indicators, such as Lost Time Injury  Frequency Rate (LTIFR), near-miss reporting rates.</skos:definition>
        <skos:prefLabel xml:lang="en">SafeWorkingConditionsAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SafetyAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SafetyAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SpecifiedAssessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/assesses"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/SafetyDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:altLabel xml:lang="en">Safety Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of safety of chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">SafetyAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The superclass of all SSbD Assessments within the safety dimension.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SafetyDimension -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SafetyDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SSbDDimension"/>
        <skos:altLabel xml:lang="en">Safety Dimension</skos:altLabel>
        <skos:definition xml:lang="en">Assessing hazards, exposure, and risks from  chemicals and materials throughout their life cycle within the  SSbD framework.</skos:definition>
        <skos:definition xml:lang="en">The dimension of safety in the context of SSbD assessments.</skos:definition>
        <skos:prefLabel xml:lang="en">SafetyDimension</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SedimentToxicity -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SedimentToxicity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnvironmentalRiskAssessment"/>
        <terms:source>https://www.sciencedirect.com/topics/earth-and-planetary-sciences/sediment-toxicity</terms:source>
        <skos:altLabel xml:lang="en">Sediment Toxicity</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of effects of pollutants present in sediments on benthic aquatic organisms.</skos:definition>
        <skos:prefLabel xml:lang="en">SedimentToxicity</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SelfTrainingModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SelfTrainingModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SemiSupervicedLearningModel"/>
        <skos:definition xml:lang="en">A semi-supervised machine learning model that improves model performance by iteratively labeling unlabeled data.</skos:definition>
        <skos:prefLabel xml:lang="en">SelfTrainingModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SemiSupervicedLearningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SemiSupervicedLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MachineLearningModel"/>
        <skos:definition xml:lang="en">A machine learning paradigm that trains models using a small amount of labeled data combined with a large volume of unlabeled data.</skos:definition>
        <skos:prefLabel xml:lang="en">SemiSupervicedLearningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ShortData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ShortData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/IntData"/>
        <rdfs:label xml:lang="en">short data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#short"/>
        <skos:definition xml:lang="en">A data representing a 16-bit integer number.</skos:definition>
        <skos:prefLabel xml:lang="en">ShortData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SiameseNeuralNetwork -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SiameseNeuralNetwork">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DeepLearningModel"/>
        <skos:definition xml:lang="en">Class of neural network architectures containing two or more identical subnetworks with shared weights.</skos:definition>
        <skos:prefLabel xml:lang="en">SiameseNeuralNetwork</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Sign -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Sign">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label xml:lang="en">sign</rdfs:label>
        <skos:definition xml:lang="en">A sign that stands for an entity.</skos:definition>
        <skos:prefLabel xml:lang="en">Sign</skos:prefLabel>
        <skos:scopeNote xml:lang="en">A sign is a part of a triadic semiotic (meaning-making) process, where an &apos;interpreter&apos; connects a &apos;sign&apos; to an entity (called &apos;referent&apos;).</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SkinAndRespiratorySensitisation -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SkinAndRespiratorySensitisation">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/HazardIdentificationHumanHealth"/>
        <skos:altLabel xml:lang="en">Skin and Respiratory Sensitisation</skos:altLabel>
        <skos:definition xml:lang="en">Assessing skin and respiratory sensitisation</skos:definition>
        <skos:prefLabel xml:lang="en">SkinAndRespiratorySensitisation</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Respiratory sensitisation refers to hypersensitivity of the airways occurring after inhalation of a substance or a mixture. Skin sensitisation refers to an allergic response occurring after skin contact with a substance or a mixture.https://unece.org/transport/dangerous-goods/ghs-rev11-2025</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SocialDimension -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SocialDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SSbDDimension"/>
        <skos:definition xml:lang="en">The dimension of social impact in the context of SSbD assessments.</skos:definition>
        <skos:prefLabel xml:lang="en">SocialDimension</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SocialExternalitiesAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SocialExternalitiesAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ExternalitiesAssessment"/>
        <skos:altLabel xml:lang="en">Social Externalities Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of social externalities.</skos:definition>
        <skos:prefLabel xml:lang="en">SocialExternalitiesAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Social externalities are the unintended social consequences of economic activities, the hidden costs and benefits that are not reflected in market prices.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SocialSustainabilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SocialSustainabilityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SustainabilityAssessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/assesses"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/SocialSustainabilityDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:altLabel xml:lang="en">Social Sustainability Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of social sustainability aspects of chemicals and materials during production, transport,  use, and disposal.</skos:definition>
        <skos:prefLabel xml:lang="en">SocialSustainabilityAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The superclass of all SSbD Assessments within the social sustainability dimension.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SocialSustainabilityDimension -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SocialSustainabilityDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SSbDDimension"/>
        <skos:altLabel xml:lang="en">Social Sustainability Dimension</skos:altLabel>
        <skos:definition xml:lang="en">The dimension of social sustainability  within the SSbD framework for chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">SocialSustainabilityDimension</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/Software -->


    <owl:Class rdf:about="https://w3id.org/ssbd/Software">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Data"/>
        <rdfs:label xml:lang="en">software</rdfs:label>
        <skos:definition xml:lang="en">All or part of the programs, procedures, rules, and associated documentation of an information processing system.</skos:definition>
        <skos:prefLabel xml:lang="en">Software</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SoilQualityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SoilQualityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ExposureAssessmentEnvironment"/>
        <skos:altLabel xml:lang="en">Soil Quality Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing the concentration of pollutants in soil.</skos:definition>
        <skos:prefLabel xml:lang="en">SoilQualityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SpecifiedAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SpecifiedAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Assessment"/>
        <rdfs:label xml:lang="en">specified assessment</rdfs:label>
        <skos:definition xml:lang="en">An assessment that is focused on a specific aspect or dimension of safety and sustainability, such as functionality, safety, or environmental impact.</skos:definition>
        <skos:prefLabel xml:lang="en">SpecifiedAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/StepwiseRegressionModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/StepwiseRegressionModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/RegressionModel"/>
        <skos:definition xml:lang="en">A regression model of fitting regression models in which the choice of predictive variables is carried out by an automatic procedure.</skos:definition>
        <skos:prefLabel xml:lang="en">StepwiseRegressionModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/StratosphericOzoneLayerDepletionAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/StratosphericOzoneLayerDepletionAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory"/>
        <skos:altLabel xml:lang="en">Stratospheric Ozone Layer Depletion Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">Ozone layer depletion impact category consists of quantitative assessment of potential destruction of the stratospheric ozone layer primarily caused by ozone-depleting substances (ODSs) such as CFCs and HCFCs, which release chlorine or bromine atoms that accelerate the breakdown of ozone molecules.</skos:definition>
        <skos:prefLabel xml:lang="en">StratosphericOzoneLayerDepletionImpactCategory</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/StructuralMaterial -->


    <owl:Class rdf:about="https://w3id.org/ssbd/StructuralMaterial">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MaterialByFunction"/>
        <skos:definition xml:lang="en">A material Designed to bear loads and provide mechanical strength, stiffness, and durability (e.g., steel for bridges, concrete for buildings, aerospace alloys).</skos:definition>
        <skos:prefLabel xml:lang="en">StructuralMaterial</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SupervisedLearningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SupervisedLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MachineLearningModel"/>
        <skos:definition xml:lang="en">A machine learning paradigm where models are trained using labeled data (input data paired with the correct output) to learn mapping functions that predict outcomes for new, unseen data.</skos:definition>
        <skos:prefLabel xml:lang="en">SupervisedLearningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SupportVectorMachine -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SupportVectorMachine">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Classification"/>
        <skos:altLabel xml:lang="en">SVM</skos:altLabel>
        <skos:definition xml:lang="en">Supervised machine learning algorithms used for classification, regression, and outlier detection.</skos:definition>
        <skos:prefLabel xml:lang="en">SupportVectorMachine</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SustainabilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SustainabilityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SpecifiedAssessment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/ssbd/assesses"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/ssbd/SustainabilityDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <skos:altLabel xml:lang="en">Sustainability Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessments that include some aspect of sustainability within SSbD.</skos:definition>
        <skos:prefLabel xml:lang="en">SustainabilityAssessment</skos:prefLabel>
        <skos:scopeNote xml:lang="en">The superclass of all SSbD Assessments within sustainability dimension.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SustainabilityDimension -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SustainabilityDimension">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SSbDDimension"/>
        <skos:altLabel xml:lang="en">Sustainability Dimension</skos:altLabel>
        <skos:definition xml:lang="en">The dimension of sustainability in the context of SSbD assessments of chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">SustainabilityDimension</skos:prefLabel>
        <skos:scopeNote xml:lang="en">Sustainability is the state of the global system, including environmental, social and economic aspects, in which the needs of the present are met without compromising the ability of future generations to meet their own need. Note 1 to entry:The environmental, social and economic aspects interact, are interdependent and are often referred to as the three dimensions of sustainability. Note 2 to entry: Sustainability is the goal of sustainable development. https://www.iso.org/obp/ui/en/#iso:std:iso:guide:82:ed-2:v1:en</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/SymbolicData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/SymbolicData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Data"/>
        <rdfs:label xml:lang="en">symbolic data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/2012/REC-owl2-syntax-20121211/#Datatype_Maps"/>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/2012/REC-xmlschema11-2-20120405/#built-in-datatypes"/>
        <skos:definition xml:lang="en">The class for entities which stands for a specific data format expressed using a symbolic encoding.</skos:definition>
        <skos:prefLabel xml:lang="en">SymbolicData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/TDistributedStochasticNeighborEmbedding -->


    <owl:Class rdf:about="https://w3id.org/ssbd/TDistributedStochasticNeighborEmbedding">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DimensionalityReduction"/>
        <skos:altLabel xml:lang="en">t-SNE</skos:altLabel>
        <skos:definition xml:lang="en">A non-linear dimensionality reduction model excellent for visualizing high-dimensional data in 2D or 3D.</skos:definition>
        <skos:prefLabel xml:lang="en">TDistributedStochasticNeighborEmbedding</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/TargetTracking -->


    <owl:Class rdf:about="https://w3id.org/ssbd/TargetTracking">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ComputerVision"/>
        <skos:definition xml:lang="en">A computer vision model for automatically identifying objects in a video and interpreting them as a set of trajectories with high accuracy.</skos:definition>
        <skos:prefLabel xml:lang="en">TargetTracking</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/TerrestrialEutrophicationImpactAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/TerrestrialEutrophicationImpactAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/LifeCycleImpactAssessmentCategory"/>
        <skos:altLabel xml:lang="en">Terrestrial Eutrophication Impact Category</skos:altLabel>
        <skos:definition xml:lang="en">Terrestrial Eutrophication  in Life Cycle Assessment (LCA) is an environmental impact category measuring the potential impacts of nutrient enrichment in soils.</skos:definition>
        <skos:prefLabel xml:lang="en">TerrestrialEutrophicationImpactCategory</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This is a LCA impact category.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/TerrestrialToxicity -->


    <owl:Class rdf:about="https://w3id.org/ssbd/TerrestrialToxicity">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/EnvironmentalRiskAssessment"/>
        <terms:source>https://www.sciencedirect.com/science/chapter/edited-volume/pii/B9780128137246000293</terms:source>
        <skos:altLabel xml:lang="en">Terrestrial Toxicity</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of effects of a chemical on ecological compartments (soil, sediment) and biological receptors that spend a significant amount of time in a terrestrial environment (invertebrates, reptiles, mammals, birds, plants).</skos:definition>
        <skos:prefLabel xml:lang="en">TerrestrialToxicity</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/TextGeneration -->


    <owl:Class rdf:about="https://w3id.org/ssbd/TextGeneration">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/NaturalLanguageGeneration"/>
        <skos:definition xml:lang="en">Natural language subfield that focuses on automatically producing human-like, coherent, and contextually relevant text or speech from structured or unstructured data.</skos:definition>
        <skos:prefLabel xml:lang="en">TextGeneration</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/ThermalPropertiesAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/ThermalPropertiesAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/FunctionalityAssessment"/>
        <skos:altLabel xml:lang="en">Thermal Properties Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of thermal properties of chemicals and materials.</skos:definition>
        <skos:prefLabel xml:lang="en">ThermalPropertiesAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/TierLevel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/TierLevel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/Sign"/>
        <rdfs:label xml:lang="en">tier level</rdfs:label>
        <skos:definition xml:lang="en">A sign that represents a tiered, iterative framework for evaluating chemical and material safety from early innovation to production.</skos:definition>
        <skos:prefLabel xml:lang="en">TierLevel</skos:prefLabel>
        <skos:scopeNote xml:lang="en">This approach typically involves a three-tier system-ranging from qualitative, early-stage, in silico, and in vitro screening to, finally, advanced, quantitative, in vivo testing.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/TimeData -->


    <owl:Class rdf:about="https://w3id.org/ssbd/TimeData">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SymbolicData"/>
        <rdfs:label xml:lang="en">time data</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/xmlschema11-2/#time"/>
        <skos:definition xml:lang="en">A symbolic data representing time. Format: hh:mm:ss (followed by an optional time zone offset, e.g. +01:00 for Central Europe).</skos:definition>
        <skos:prefLabel xml:lang="en">TimeData</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/TransformerAI -->


    <owl:Class rdf:about="https://w3id.org/ssbd/TransformerAI">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/DeepLearningModel"/>
        <skos:definition xml:lang="en">Deep-learning architecture introduced by Google in 2017 that power modern generative AI like ChatGPT and Gemini.</skos:definition>
        <skos:prefLabel xml:lang="en">TransformerAI</skos:prefLabel>
        <skos:scopeNote xml:lang="en"></skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/UnsupervicedLearningModel -->


    <owl:Class rdf:about="https://w3id.org/ssbd/UnsupervicedLearningModel">
        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#MachineLearningModel"/>
        <skos:definition xml:lang="en">A type of machine learning that analyzes and clusters unlabeled datasets to discover hidden patterns, structures, or relationships without human intervention.</skos:definition>
        <skos:prefLabel xml:lang="en">UnsupervicedLearningModel</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/WaterQualityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/WaterQualityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/ExposureAssessmentEnvironment"/>
        <skos:altLabel xml:lang="en">Water Quality Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessing the concentration of water pollutants in water.</skos:definition>
        <skos:prefLabel xml:lang="en">WaterQualityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/WorkerSocialResponsibilityAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/WorkerSocialResponsibilityAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/SocialSustainabilityAssessment"/>
        <skos:altLabel xml:lang="en">Worker Social Responsibility</skos:altLabel>
        <skos:definition xml:lang="en">Assessing whether workers are given fair renumeration, have decent working hours or as per regulations, are allowed freedom of association and form collective bargaining , etc.</skos:definition>
        <skos:prefLabel xml:lang="en">SocialSustainabilityAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/WorkingHoursAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/WorkingHoursAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/WorkerSocialResponsibilityAssessment"/>
        <skos:altLabel xml:lang="en">Working Hours</skos:altLabel>
        <skos:definition xml:lang="en">Assessing whether employees and workers are working as per the laws.</skos:definition>
        <skos:prefLabel xml:lang="en">WorkingHoursAssessment</skos:prefLabel>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/XGBoostRegessor -->


    <owl:Class rdf:about="https://w3id.org/ssbd/XGBoostRegessor">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/PredictionLearningModel"/>
        <skos:definition xml:lang="en">An optimized machine learning algorithm that uses an ensemble of decision trees within a gradient boosting framework to predict continuous numerical values.</skos:definition>
        <skos:prefLabel xml:lang="en">XGBoostRegressor</skos:prefLabel>
        <skos:scopeNote xml:lang="en">XGBoost Regressor is widely used in data science competitions and real-world applications due to its speed, performance, and features like built-in regularization and automatic handling of missing values.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/ssbd/YoungsModulusAssessment -->


    <owl:Class rdf:about="https://w3id.org/ssbd/YoungsModulusAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/ssbd/MechanicalPropertiesAssessment"/>
        <skos:altLabel xml:lang="en">Young&apos;s Modulus Assessment</skos:altLabel>
        <skos:definition xml:lang="en">Assessment of Young&apos;s modulus of materials.</skos:definition>
        <skos:prefLabel xml:lang="en">YoungsModulusAssessment</skos:prefLabel>
    </owl:Class>
    


