        <rdfs:subClassOf rdf:resource="https://w3id.org/emmo/hume#ChemicalEntity"/>
    </rdf:Description>
    


    <!-- http://semanticscience.org/resource/CHEMINF_000123 -->


    <rdf:Description rdf:about="http://semanticscience.org/resource/CHEMINF_000123">
