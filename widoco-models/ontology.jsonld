  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "wasAttributedTo"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/ns/prov#Agent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.w3.org/ns/prov#wasInfluencedBy"
  } ],
  "http://www.w3.org/ns/prov#category" : [ {
    "@value" : "starting-point"
  } ],
  "http://www.w3.org/ns/prov#component" : [ {
    "@value" : "agents-responsibility"
  } ],
  "http://www.w3.org/ns/prov#definition" : [ {
    "@language" : "en",
    "@value" : "Attribution is the ascribing of an entity to an agent."
  } ],
  "http://www.w3.org/ns/prov#inverse" : [ {
    "@value" : "contributed"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/prov#wasInformedBy",
