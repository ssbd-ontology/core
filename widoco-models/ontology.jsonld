  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.w3.org/ns/prov#wasInfluencedBy"
  } ],
  "http://www.w3.org/ns/prov#category" : [ {
    "@value" : "starting-point"
  } ],
  "http://www.w3.org/ns/prov#component" : [ {
    "@value" : "entities-activities"
  } ],
  "http://www.w3.org/ns/prov#inverse" : [ {
    "@value" : "wasUsedBy"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/prov#wasAssociatedWith",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An prov:Agent that had some (unspecified) responsibility for the occurrence of this prov:Activity."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.w3.org/ns/prov#Activity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#isDefinedBy" : [ {
    "@id" : "http://www.w3.org/ns/prov-o#"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@value" : "wasAssociatedWith"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
