  "http://purl.org/vocab/vann/usageNote" : [ {
    "@language" : "en",
    "@value" : "dcat:mediaType SHOULD be used if the type of the distribution is defined by [IANA](https://www.w3.org/TR/vocab-dcat-3/#bib-iana-media-types)."
