@prefix : <https://w3id.org/ssbd/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix emmo: <https://w3id.org/emmo/hume#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ssbd: <https://w3id.org/ssbd/> .
@prefix widoco: <https://w3id.org/widoco/vocab#> .


<https://w3id.org/ssbd/core/physical-descriptors> rdf:type owl:Ontology ;
                               owl:versionIRI <https://w3id.org/ssbd/core/0.0.1/physical-descriptors> ;
                               dcterms:abstract """
This module is a part of the [SSbD Core Ontology](https://w3id.org/ssbd).

Physical descriptors (or physical properties) are characteristics of a substance that can be observed or measured without changing the chemical identity of the substance.
"""@en ;
    dcterms:title "Physical descriptors"@en ;
    widoco:introduction """
This module is a part of the [SSbD Core Ontology](https://w3id.org/ssbd).

Physical descriptors (or physical properties) are characteristics of a substance that can be observed or measured without changing the chemical identity of the substance.
"""@en .

:PhysicalDescriptor a owl:Class ;
    rdfs:label "physical descriptor"@en ;
    rdfs:subClassOf ssbd:Property ;
    skos:definition "A descriptor for a physical properties of a material."@en ;
    skos:prefLabel "PhysicalDescriptor"@en .

:AdsorptionEnergyDescriptor a owl:Class ;
    rdfs:label "adsorption energy descriptor"@en ;
    rdfs:subClassOf :PhysicalDescriptor ;
    skos:definition "A measurable or calculated physical property—specifically the energy change when a molecule binds to a surface—used to predict and quantify catalytic activity and material behavior."@en ;
    skos:prefLabel "AdsorptionEnergyDescriptor"@en .

:BulkPolymerMechanicalProperty a owl:Class ;
    rdfs:label "bulk polymer mechanical property"@en ;
    rdfs:subClassOf :MechanicalProperty ;
    skos:definition "Mechanical properties of the bulk structure of the polymer."@en ;
    skos:prefLabel "BulkPolymerMechanicalProperty"@en .

:BulkPolymerThermalProperty a owl:Class ;
    rdfs:label "bulk polymer thermal property"@en ;
    rdfs:subClassOf :ThermalProperty ;
    skos:definition "Thermal properties of the bulk structure of the polymer."@en ;
    skos:prefLabel "BulkPolymerThermalProperty"@en .

:HamakerConstant a owl:Class ;
    rdfs:label "hamaker constant"@en ;
    rdfs:subClassOf emmo:PhysicalConstant , :PhysicalDescriptor ;
    rdfs:seeAlso "https://en.wikipedia.org/wiki/Hamaker_constant" ;
    skos:definition "A physical constant that can be defined for a van der Waals (vdW) body–body interaction."@en ;
    skos:prefLabel "HamakerConstant"@en .

:SurfacePotentialDescriptor a owl:Class ;
    rdfs:label "surface potential descriptor"@en ;
    rdfs:subClassOf :ElectricalPotentialDescriptor ;
    skos:definition "The electrical potential difference existing at the immediate boundary or interface between a surface (such as a solid, liquid, or membrane) and the adjacent bulk phase or vacuum."@en ;
    skos:prefLabel "SurfacePotentialDescriptor"@en .

:ZetaPotential a owl:Class ;
    rdfs:label "zeta potential"@en ;
    rdfs:seeAlso "http://en.wikipedia.org/wiki/Zeta_potential; http://purl.obolibrary.org/obo/NCIT_C158424" ;
    rdfs:subClassOf :ElectricalPotentialDescriptor ;
    skos:definition "The magnitude of the electrical potential as generated by ion accumulation at the particulate surface. This surface consists of two layers, the Stern layer and the diffuse layer, which comprise an electrical double-layer. The measurement of the electrical potential provides important information regarding the dispersion mechanism, the degree of particle dispersion and the electrostatic potential of the sample"@en ;
    skos:prefLabel "ZetaPotential"@en ;
    skos:scopeNote "Electrical potential at the slipping plane of the interface of a charged particle in a fluid." .

:MechanicalProperty a owl:Class ;
    rdfs:label "mechanical property"@en ;
    rdfs:subClassOf :PhysicalDescriptor ;
    skos:definition "Mechanical property of a bulk structure."@en ;
    skos:prefLabel "MechanicalProperty"@en .

:ThermalProperty a owl:Class ;
    rdfs:label "thermal property"@en ;
    rdfs:subClassOf :PhysicalDescriptor ;
    skos:definition "Thermal property of a bulk structure."@en ;
    skos:prefLabel "ThermalProperty"@en .

:ElectricalPotentialDescriptor a owl:Class ;
    rdfs:label "electric potential descriptor"@en ;
    rdfs:subClassOf :PhysicalDescriptor ;
    skos:definition "A descriptor of the electrical potential between two given points in a static electric field."@en ;
    skos:prefLabel "ElectricalPotentialDescriptor"@en .
